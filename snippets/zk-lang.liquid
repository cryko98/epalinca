{%- comment -%}
  Language switcher, styled as the reference design's `.lang` pill group.

  Uses Shopify's native localization form, so switching actually changes the storefront
  locale: it re-renders every {{ '...' | t }} string, uses the localized URL (/hu, /en),
  and carries through to product translations, checkout and notification emails. A purely
  client-side text swap would do none of that.

  Renders nothing while the shop has only one published language, so the control never
  appears as a dead single-option toggle.
{%- endcomment -%}

{%- if localization.available_languages.size > 1 -%}
  <form method="post" action="{{ routes.root_url }}localization" class="lang" id="zkLangForm" accept-charset="UTF-8">
    <input type="hidden" name="form_type" value="localization">
    <input type="hidden" name="utf8" value="✓">
    <input type="hidden" name="_method" value="put">
    <input type="hidden" name="return_to" value="{{ request.path | escape }}">
    {%- for lang in localization.available_languages -%}
      <button
        type="submit"
        name="locale_code"
        value="{{ lang.iso_code }}"
        lang="{{ lang.iso_code }}"
        class="{% if lang.iso_code == localization.language.iso_code %}on{% endif %}"
        {% if lang.iso_code == localization.language.iso_code %}aria-current="true"{% endif %}
        title="{{ lang.endonym_name | capitalize }}">
        {{ lang.iso_code | upcase }}
      </button>
    {%- endfor -%}
  </form>
{%- endif -%}
