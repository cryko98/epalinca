{%- comment -%}
  Award medals for the top-right corner of a product picture (cards and the product
  page stage). Every award in the zekulhyda.awards metafield is drawn, stacked under
  each other, so a bottle with several distinctions shows all of them.

  Line format: metal|ring text|figure|label   e.g. gold|QUINTESSENCE 2026|AUR|medalie de aur
  The 2026 Quintessence and ÁKOVITA stickers are photographs; older awards get a drawn ring.

  Renders nothing when the product has no awards recorded.

  Usage: {% render 'zk-award-mini', product: product %}
{%- endcomment -%}

{%- assign awards = product.metafields.zekulhyda.awards.value -%}

{%- if awards != blank and awards.size > 0 -%}
<span class="zk-mini-stack">
  {%- for line in awards -%}
  {%- liquid
    assign parts = line | split: '|'
    assign metal = parts[0] | strip | downcase
    assign ring  = parts[1] | strip
    assign fig   = parts[2] | strip
    assign label = parts[3] | strip

    case metal
      when 'champ'
        assign c1 = '#FFF1C2'
        assign c2 = '#E4B65A'
        assign c3 = '#8A5F1E'
      when 'silver'
        assign c1 = '#F2F2F2'
        assign c2 = '#B9BCC2'
        assign c3 = '#6E7178'
      when 'bronze'
        assign c1 = '#E8B98C'
        assign c2 = '#B87A4B'
        assign c3 = '#6E4426'
      else
        assign c1 = '#F6E3A1'
        assign c2 = '#C9963B'
        assign c3 = '#7A5416'
    endcase

    assign uid = 'mini' | append: product.id | append: forloop.index

    # The metafield is written in Romanian; the words on the medal follow the storefront language.
    case fig
      when 'AUR'
        assign fig = 'zk.bd_gold' | t
      when 'ARGINT'
        assign fig = 'zk.bd_silver' | t
      when 'BRONZ'
        assign fig = 'zk.bd_bronze' | t
    endcase
    assign label_key = label | downcase
    case label_key
      when 'medalie de aur'
        assign label = 'zk.md_gold_l' | t
      when 'medalie de argint'
        assign label = 'zk.md_silver_l' | t
      when 'medalie de bronz'
        assign label = 'zk.md_bronze_l' | t
      when 'campion de categorie'
        assign label = 'zk.md_champ_l' | t
      when 'akovita-prune'
        assign label = 'zk.md_akovita_l' | t
      when 'medaliat'
        assign label = 'zk.md_medal_l' | t
    endcase

    assign photo = ''
    if ring contains 'ÁKOVITA' or ring contains 'AKOVITA'
      if metal == 'champ'
        assign photo = 'zk-medal-akovita-champion-2026.png'
      elsif metal == 'gold'
        assign photo = 'zk-medal-akovita-gold-2026.png'
      elsif metal == 'silver'
        assign photo = 'zk-medal-akovita-silver-2026.png'
      elsif metal == 'bronze'
        assign photo = 'zk-medal-akovita-bronze-2026.png'
      endif
    elsif ring contains '2026'
      if metal == 'champ'
        assign photo = 'zk-medal-champion-2026.png'
      elsif metal == 'gold'
        assign photo = 'zk-medal-gold-2026.png'
      elsif metal == 'silver'
        assign photo = 'zk-medal-silver-2026.png'
      elsif metal == 'bronze'
        assign photo = 'zk-medal-bronze-2026.png'
      endif
    elsif ring contains '2025'
      if metal == 'champ'
        assign photo = 'zk-medal-champion-2025.png'
      elsif metal == 'gold'
        assign photo = 'zk-medal-gold-2025.png'
      elsif metal == 'silver'
        assign photo = 'zk-medal-silver-2025.png'
      elsif metal == 'bronze'
        assign photo = 'zk-medal-bronze-2025.png'
      endif
    endif
  -%}
  <span class="zk-mini" title="{{ ring | escape }} — {{ label | escape }}" aria-label="{{ ring | escape }} — {{ label | escape }}">
    {%- if photo != blank -%}
    <img src="{{ photo | asset_url }}" alt="{{ ring | escape }} — {{ label | escape }}" width="52" height="52" loading="lazy">
    {%- else -%}
    <svg viewBox="0 0 200 200" role="img">
      <defs>
        <linearGradient id="{{ uid }}a" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="{{ c1 }}"/><stop offset=".5" stop-color="{{ c2 }}"/><stop offset="1" stop-color="{{ c3 }}"/>
        </linearGradient>
      </defs>
      <circle cx="100" cy="100" r="98" fill="url(#{{ uid }}a)"/>
      <circle cx="100" cy="100" r="86" fill="none" stroke="{{ c3 }}" stroke-opacity=".45" stroke-width="3"/>
      <circle cx="100" cy="100" r="62" fill="#0F0F11"/>
      <text x="100" y="{% if fig.size > 2 %}116{% else %}122{% endif %}" text-anchor="middle"
            font-family="Cormorant Garamond,serif" font-size="{% if fig.size > 2 %}52{% else %}72{% endif %}" fill="{{ c1 }}">{{ fig }}</text>
      <path d="M42 42 q58 -38 116 0" fill="none" stroke="#fff" stroke-opacity=".35" stroke-width="9" stroke-linecap="round"/>
    </svg>
    {%- endif -%}
  </span>
  {%- endfor -%}
</span>
{%- endif -%}
