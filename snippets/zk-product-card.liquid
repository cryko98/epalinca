{%- comment -%}
  One product card, shared by the homepage grid and the collection pages so they cannot
  drift apart.

  Accepts:
    product  - the product
    dark     - truthy on the dark pages (collection); the homepage grid sits on paper

  Usage: {% render 'zk-product-card', product: product %}
{%- endcomment -%}

{%- capture handles -%}{%- for c in product.collections -%}{{ c.handle }} {% endfor -%}{%- endcapture -%}

{%- comment -%}
  data-price (in cents) and data-stock let the homepage filter bar narrow the grid by
  price and availability without another request; data-c carries the categories.
{%- endcomment -%}
<div class="card reveal" data-c="{{ handles | strip }}" data-price="{{ product.price }}" data-stock="{{ product.available }}">
  <a class="pic{% if product.featured_image %} photo{% endif %}{% if product.images.size > 1 %} has-alt{% endif %}" href="{{ product.url }}">
    {% render 'zk-product-image', product: product %}
    {%- if product.images.size > 1 -%}
      {%- comment -%} Second shot, crossfaded in on hover. {%- endcomment -%}
      <img class="pic-alt" src="{{ product.images[1] | image_url: width: 700 }}" alt="" loading="lazy" aria-hidden="true">
    {%- endif -%}
    {% render 'zk-award-mini', product: product %}
    {%- for tag in product.tags -%}
      {%- if tag contains 'badge:' -%}
        <span class="badge">{{ tag | remove: 'badge:' }}</span>
      {%- endif -%}
    {%- endfor -%}
  </a>

  <div class="body">
    <span class="fruit">{{ product.type | default: product.vendor }}</span>
    <h3><a href="{{ product.url }}">{{ product.title }}</a></h3>
    <p class="note">{{ product.description | strip_html | truncate: 96 }}</p>

    <div class="row">
      <div class="price">
        {{ product.price | money }}
        {%- if product.variants.first.title != 'Default Title' %}
          <small>{{ product.variants.first.title }}</small>
        {%- endif %}
      </div>

      {%- if product.available -%}
        <form action="{{ routes.cart_add_url }}" method="post" enctype="multipart/form-data">
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
          <input type="hidden" name="quantity" value="1">
          <button type="submit" class="add">{{ 'products.add_to_cart' | t }}</button>
        </form>
      {%- else -%}
        <button class="add" disabled>{{ 'products.sold_out' | t }}</button>
      {%- endif -%}
    </div>
  </div>
</div>
