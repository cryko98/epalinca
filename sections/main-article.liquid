{%- capture meta -%}
  {{ article.published_at | date: '%d %B %Y' }}
  {%- if article.author != blank %} · {{ article.author }}{% endif -%}
{%- endcapture -%}

{% render 'zk-page-head',
   eyebrow: blog.title,
   title: article.title,
   lead: article.excerpt,
   meta: meta %}

<article class="zk-article">
  {%- if article.image -%}
    <div class="zk-article__hero">
      <img src="{{ article.image | image_url: width: 1600 }}"
           width="{{ article.image.width }}" height="{{ article.image.height }}"
           alt="{{ article.title | escape }}" loading="eager">
    </div>
  {%- endif -%}

  <div class="wrap zk-body">
    <div class="zk-rte">{{ article.content }}</div>

    {%- if article.tags.size > 0 -%}
      <div class="zk-article__tags">
        {%- for tag in article.tags -%}<span>{{ tag }}</span>{%- endfor -%}
      </div>
    {%- endif -%}

    <div class="zk-article__foot">
      <a class="btn" href="{{ blog.url }}">← {{ 'blogs.back' | t }}</a>
    </div>
  </div>
</article>

{% schema %}
{"name": "Main Articol", "settings": []}
{% endschema %}
