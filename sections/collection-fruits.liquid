<section class="section-fruits" style="background:{{ section.settings.bg_color }};padding:{{ section.settings.padding_top }}px 60px {{ section.settings.padding_bottom }}px;">
  <div class="section-inner">
    <div class="section-head reveal">
      <div>
        <div class="section-label">
          <span class="section-label__line" style="background:{{ section.settings.accent_color }};"></span>
          <span class="section-label__text" style="color:{{ section.settings.accent_color }};">{{ section.settings.eyebrow }}</span>
        </div>
        <h2 class="section-title" style="color:{{ section.settings.title_color }};">
          {{ section.settings.title }}
          {% if section.settings.title_italic != blank %}
          <em style="color:{{ section.settings.accent_color }};">{{ section.settings.title_italic }}</em>
          {% endif %}
        </h2>
        {% if section.settings.subtitle != blank %}
        <p class="section-subtitle" style="color:{{ section.settings.subtitle_color }};">{{ section.settings.subtitle }}</p>
        {% endif %}
      </div>
    </div>

    <div class="fruits-grid" style="grid-template-columns:repeat({{ section.settings.columns }},1fr);">
      {% for block in section.blocks %}
      <div class="fruit-card reveal delay-{{ forloop.index }}" style="--fruit-color:{{ block.settings.fruit_color }};" {{ block.shopify_attributes }}>
        <div class="fruit-card__top" style="background:{{ block.settings.fruit_color | color_modify: 'alpha', 0.12 }};border-bottom:2px solid {{ block.settings.fruit_color | color_modify: 'alpha', 0.3 }};">
          {% if block.settings.fruit_image != blank %}
            <img src="{{ block.settings.fruit_image | img_url: '400x' }}" alt="{{ block.settings.fruit_name }}" class="fruit-card__img">
          {% else %}
            <div class="fruit-card__emoji" style="font-size:{{ section.settings.emoji_size }}px;">{{ block.settings.fruit_emoji }}</div>
          {% endif %}
          <div class="fruit-card__color-dot" style="background:{{ block.settings.fruit_color }};"></div>
        </div>
        <div class="fruit-card__info" style="background:{{ section.settings.card_bg }};">
          <p class="fruit-card__type" style="color:{{ block.settings.fruit_color }};">{{ block.settings.fruit_type }}</p>
          <h3 class="fruit-card__name" style="color:{{ section.settings.card_title_color }};">{{ block.settings.fruit_name }}</h3>
          <p class="fruit-card__notes" style="color:{{ section.settings.card_desc_color }};">{{ block.settings.tasting_notes }}</p>
          <div class="fruit-card__foot">
            <span class="fruit-card__price" style="color:{{ section.settings.card_title_color }};">
              <sub style="color:{{ section.settings.card_desc_color }};">{{ cart.currency.symbol }}</sub>{{ block.settings.price }}
            </span>
            <a href="{% if block.settings.product_handle != blank %}/products/{{ block.settings.product_handle }}{% else %}/collections/all{% endif %}"
               class="fruit-add" style="background:{{ block.settings.fruit_color }};color:{{ section.settings.btn_text_color }};">
              {{ section.settings.btn_text | default: 'Cumpără' }}
            </a>
          </div>
        </div>
      </div>
      {% endfor %}
    </div>

    {% if section.settings.cta_text != blank %}
    <div class="fruits-cta reveal" style="text-align:center;margin-top:56px;">
      <a href="{{ section.settings.cta_url | default: '/collections/all' }}" class="btn-primary" style="background:{{ section.settings.accent_color }};color:{{ section.settings.btn_text_color }};">
        {{ section.settings.cta_text }}
      </a>
    </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Colecție Fructe (Colorat)",
  "settings": [
    { "type": "header", "content": "Titlu secțiune" },
    { "type": "text", "id": "eyebrow", "label": "Text mic (eyebrow)", "default": "Fructele Ținutului" },
    { "type": "textarea", "id": "title", "label": "Titlu", "default": "Distilate Vii," },
    { "type": "text", "id": "title_italic", "label": "Titlu italic", "default": "Culori Vii." },
    { "type": "textarea", "id": "subtitle", "label": "Subtitlu", "default": "Fiecare fruct — o culoare, un caracter, o poveste din Bihor. Distilate artizanale fără compromisuri." },
    { "type": "range", "id": "columns", "min": 2, "max": 5, "step": 1, "label": "Coloane", "default": 4 },
    { "type": "header", "content": "Butoane" },
    { "type": "text", "id": "btn_text", "label": "Text buton cumpără", "default": "Cumpără" },
    { "type": "text", "id": "cta_text", "label": "Text buton 'toate' (opțional)", "default": "Vezi toate distilatatele" },
    { "type": "url", "id": "cta_url", "label": "Link buton 'toate'" },
    { "type": "header", "content": "Culori" },
    { "type": "color", "id": "bg_color", "label": "Fundal secțiune", "default": "#f0ead8" },
    { "type": "color", "id": "accent_color", "label": "Culoare accent", "default": "#7a6128" },
    { "type": "color", "id": "title_color", "label": "Culoare titlu", "default": "#0c0b09" },
    { "type": "color", "id": "subtitle_color", "label": "Culoare subtitlu", "default": "#5a5040" },
    { "type": "color", "id": "card_bg", "label": "Fundal card", "default": "#faf6ee" },
    { "type": "color", "id": "card_title_color", "label": "Culoare titlu produs", "default": "#0c0b09" },
    { "type": "color", "id": "card_desc_color", "label": "Culoare descriere", "default": "#5a5040" },
    { "type": "color", "id": "btn_text_color", "label": "Culoare text butoane", "default": "#ffffff" },
    { "type": "range", "id": "emoji_size", "min": 40, "max": 100, "step": 4, "unit": "px", "label": "Mărime emoji fruct", "default": 64 },
    { "type": "header", "content": "Spațiere" },
    { "type": "range", "id": "padding_top", "min": 60, "max": 160, "step": 10, "unit": "px", "label": "Spațiu sus", "default": 120 },
    { "type": "range", "id": "padding_bottom", "min": 60, "max": 160, "step": 10, "unit": "px", "label": "Spațiu jos", "default": 120 }
  ],
  "blocks": [
    {
      "type": "fruit",
      "name": "Fruct / Produs",
      "settings": [
        { "type": "image_picker", "id": "fruit_image", "label": "Imagine fruct (opțional)" },
        { "type": "text", "id": "fruit_emoji", "label": "Emoji fruct (dacă nu există imagine)", "default": "🍑" },
        { "type": "color", "id": "fruit_color", "label": "Culoare accent fruct", "default": "#f28c3a" },
        { "type": "text", "id": "fruit_type", "label": "Tip distilat", "default": "Distilat de Caise" },
        { "type": "text", "id": "fruit_name", "label": "Nume produs", "default": "Caisă" },
        { "type": "textarea", "id": "tasting_notes", "label": "Note de degustare / descriere", "default": "Florale, miere de albine, piersică coaptă. Final lung și catifelat." },
        { "type": "text", "id": "price", "label": "Preț", "default": "85.00" },
        { "type": "text", "id": "product_handle", "label": "Handle produs Shopify" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Colecție Fructe",
      "blocks": [
        { "type": "fruit", "settings": { "fruit_emoji": "🍑", "fruit_color": "#f28c3a", "fruit_type": "Distilat de Caise", "fruit_name": "Caisă", "tasting_notes": "Florale, miere, piersică coaptă. Final catifelat și aromat.", "price": "85.00" }},
        { "type": "fruit", "settings": { "fruit_emoji": "🍐", "fruit_color": "#7ab83e", "fruit_type": "Distilat de Pere", "fruit_name": "Pară Williams", "tasting_notes": "Proaspăt, floral, cu note de vanilie. Elegant și ușor.", "price": "90.00" }},
        { "type": "fruit", "settings": { "fruit_emoji": "🍒", "fruit_color": "#c9243a", "fruit_type": "Distilat de Vișine", "fruit_name": "Vișin Sălbatic", "tasting_notes": "Intens, fructat, cu note de migdale și ciocolată. Campion 2025.", "price": "145.00" }},
        { "type": "fruit", "settings": { "fruit_emoji": "🍎", "fruit_color": "#e8342a", "fruit_type": "Distilat de Mere", "fruit_name": "Măr Barrique", "tasting_notes": "Mere Érmelléki maturate în barique. Complex, rotund, cu final lemnos.", "price": "130.00" }},
        { "type": "fruit", "settings": { "fruit_emoji": "🫐", "fruit_color": "#5a3aaa", "fruit_type": "Distilat de Prune", "fruit_name": "Prună Neagră", "tasting_notes": "Prun negru copt, condimente discrete, fundal de piele fină.", "price": "95.00" }},
        { "type": "fruit", "settings": { "fruit_emoji": "🍈", "fruit_color": "#d4a82a", "fruit_type": "Distilat de Gutui", "fruit_name": "Gutui (Birs)", "tasting_notes": "Exotic, parfumat, unic. Gutui coapte din livezile Bihorului.", "price": "110.00" }}
      ]
    }
  ]
}
{% endschema %}
