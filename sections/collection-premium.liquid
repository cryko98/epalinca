{%- liquid
  assign col = section.settings.collection
  if col != blank
    assign items = col.products
  else
    assign items = collections.all.products
  endif
-%}

<section id="shop">
  <div class="wrap">
    <div class="sec-head reveal">
      <div class="eyebrow">{{ section.settings.shop_eyebrow }}</div>
      <h2>{{ section.settings.shop_title }}</h2>
      <p>{{ section.settings.shop_sub }}</p>
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="filters">
        <a class="on" href="{{ routes.all_products_collection_url }}">{{ section.settings.filter_all | default: 'Toate' }}</a>
        {%- for block in section.blocks -%}
          {%- assign fc = collections[block.settings.collection] -%}
          {%- if fc != blank -%}
            <a href="{{ fc.url }}" {{ block.shopify_attributes }}>{{ block.settings.label | default: fc.title }}</a>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    <div class="grid">
      {%- for product in items limit: section.settings.products_count -%}
        <div class="card reveal">
          <a class="pic{% if product.featured_image %} photo{% endif %}" href="{{ product.url }}">
            {% render 'zk-product-image', product: product %}
            {%- for tag in product.tags -%}
              {%- if tag contains 'badge:' -%}
                <span class="badge">{{ tag | remove: 'badge:' }}</span>
              {%- endif -%}
            {%- endfor -%}
          </a>

          <div class="body">
            <span class="fruit">{{ product.type | default: product.vendor }}</span>
            <h3><a href="{{ product.url }}">{{ product.title }}</a></h3>
            <p class="note">{{ product.description | strip_html | truncate: 96 }}</p>

            <div class="row">
              <div class="price">
                {{ product.price | money }}
                {%- if product.variants.first.title != 'Default Title' %}
                  <small>{{ product.variants.first.title }}</small>
                {%- endif %}
              </div>

              {%- if product.available -%}
                <form action="{{ routes.cart_add_url }}" method="post" enctype="multipart/form-data">
                  <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                  <input type="hidden" name="quantity" value="1">
                  <button type="submit" class="add">{{ section.settings.add_label | default: 'În coș' }}</button>
                </form>
              {%- else -%}
                <button class="add" disabled>{{ section.settings.sold_label | default: 'Epuizat' }}</button>
              {%- endif -%}
            </div>
          </div>
        </div>
      {%- else -%}
        <p class="empty">Nu există produse publicate încă.</p>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Magazin",
  "settings": [
    { "type": "text", "id": "shop_eyebrow", "label": "Etichetă", "default": "Magazin online" },
    { "type": "textarea", "id": "shop_title", "label": "Titlu", "default": "Comandă direct <em>de la distilerie.</em>" },
    { "type": "textarea", "id": "shop_sub", "label": "Subtitlu", "default": "Livrare gratuită peste 250 lei în România. Nu vindem alcool persoanelor sub 18 ani." },
    { "type": "collection", "id": "collection", "label": "Colecție (gol = toate produsele)" },
    { "type": "range", "id": "products_count", "min": 4, "max": 40, "step": 4, "label": "Număr de produse", "default": 12 },
    { "type": "text", "id": "filter_all", "label": "Etichetă „toate”", "default": "Toate" },
    { "type": "text", "id": "add_label", "label": "Buton adăugare", "default": "În coș" },
    { "type": "text", "id": "sold_label", "label": "Text epuizat", "default": "Epuizat" }
  ],
  "blocks": [
    {
      "type": "filter",
      "name": "Filtru (colecție)",
      "settings": [
        { "type": "text", "id": "collection", "label": "Handle colecție", "info": "ex. barrique" },
        { "type": "text", "id": "label", "label": "Etichetă" }
      ]
    }
  ],
  "presets": [{ "name": "Magazin — grilă produse" }]
}
{% endschema %}
