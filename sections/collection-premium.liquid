{%- liquid
  assign col = section.settings.collection
  if col != blank
    assign items = col.products
  else
    assign items = collections.all.products
  endif
-%}

<section id="shop">
  <div class="wrap">
    <div class="sec-head reveal">
      <div class="eyebrow">{% render 'zk-t', override: section.settings.shop_eyebrow, key: 'zk.shop_eyebrow' %}</div>
      <h2>{% render 'zk-t', override: section.settings.shop_title, key: 'zk.shop_title' %}</h2>
      <p>{% render 'zk-t', override: section.settings.shop_sub, key: 'zk.shop_sub' %}</p>
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="filters" id="zkFilters">
        <button type="button" class="on" data-f="*">
          {%- render 'zk-t', override: section.settings.filter_all, key: 'zk.shop_all' -%}
        </button>
        {%- for block in section.blocks -%}
          {%- assign fc = block.settings.collection -%}
          {%- if fc != blank -%}
            <button type="button" data-f="{{ fc.handle }}" {{ block.shopify_attributes }}>
              {{- block.settings.label | default: fc.title -}}
            </button>
          {%- endif -%}
        {%- endfor -%}
      </div>

      {%- comment -%}
        Second row: narrow by price and by stock. Works on the cards already on the page,
        combined with whichever category is selected above.
      {%- endcomment -%}
      <div class="filters filters--fine" id="zkFine">
        <span class="filters__lbl">{{ 'zk.filter_price' | t }}</span>
        <button type="button" class="on" data-p="*">{{ 'zk.shop_all' | t }}</button>
        <button type="button" data-p="0-10000">&lt; 100 lei</button>
        <button type="button" data-p="10000-15000">100–150 lei</button>
        <button type="button" data-p="15000-99999999">&gt; 150 lei</button>
        <label class="filters__chk">
          <input type="checkbox" id="zkInStock">
          <span>{{ 'zk.filter_instock' | t }}</span>
        </label>
      </div>
    {%- endif -%}

    {%- comment -%}
      "All products" came straight from collections.all, which is ordered by handle and so
      opened with the seven Distilat bottles. The grid walks the filter categories in
      order instead — fruit first, blue last — and then picks up anything not in a
      category, so the default view reads the way the category row does. `done` keeps a
      product that belongs to two categories from being rendered twice.
    {%- endcomment -%}
    <div class="grid" id="zkGrid">
      {%- assign done = '' -%}

      {%- for block in section.blocks -%}
        {%- assign fc = block.settings.collection -%}
        {%- if fc == blank or block.settings.skip_order -%}{%- continue -%}{%- endif -%}
        {%- for product in fc.products -%}
          {%- assign key = '|' | append: product.id | append: '|' -%}
          {%- unless done contains key -%}
            {%- assign done = done | append: key -%}
            {% render 'zk-product-card', product: product %}
          {%- endunless -%}
        {%- endfor -%}
      {%- endfor -%}

      {%- for product in items -%}
        {%- assign key = '|' | append: product.id | append: '|' -%}
        {%- unless done contains key -%}
          {%- assign done = done | append: key -%}
          {% render 'zk-product-card', product: product %}
        {%- endunless -%}
      {%- endfor -%}

      {%- if done == blank -%}
        <p class="empty">{{ 'collections.no_products' | t }}</p>
      {%- endif -%}
    </div>

    <p class="zk-noresult" id="zkNoResult" hidden>{{ 'collections.no_products' | t }}</p>
  </div>
</section>

<script>
  (function () {
    var bar = document.getElementById('zkFilters');
    var fine = document.getElementById('zkFine');
    var grid = document.getElementById('zkGrid');
    if (!bar || !grid) return;

    var cards = [].slice.call(grid.querySelectorAll('.card'));
    var empty = document.getElementById('zkNoResult');
    var stockBox = document.getElementById('zkInStock');

    // The range tiers, the Barrique / Distilat calls to action and the medal strip link
    // here using the design's own data-f values, which do not all match the handles.
    var ALIAS = { distilat: 'distilat-sticla-albastra' };

    // Three independent criteria; a card must pass all of them.
    var state = { cat: '*', price: '*', stock: false };

    function passes(card) {
      if (state.cat !== '*') {
        var cats = ' ' + (card.getAttribute('data-c') || '') + ' ';
        if (cats.indexOf(' ' + state.cat + ' ') < 0) return false;
      }
      if (state.price !== '*') {
        var p = parseInt(card.getAttribute('data-price') || '0', 10);
        var lo = parseInt(state.price.split('-')[0], 10), hi = parseInt(state.price.split('-')[1], 10);
        if (p < lo || p > hi) return false;
      }
      if (state.stock && card.getAttribute('data-stock') !== 'true') return false;
      return true;
    }

    function render() {
      var shown = 0;
      cards.forEach(function (card) { var ok = passes(card); card.hidden = !ok; if (ok) shown++; });
      if (empty) empty.hidden = shown > 0;
      [].slice.call(bar.querySelectorAll('button')).forEach(function (b) {
        var v = b.getAttribute('data-f');
        b.classList.toggle('on', (ALIAS[v] || v) === state.cat);
      });
      if (fine) [].slice.call(fine.querySelectorAll('button')).forEach(function (b) {
        b.classList.toggle('on', b.getAttribute('data-p') === state.price);
      });
    }

    function setCat(value) { state.cat = ALIAS[value] || value; render(); }

    bar.addEventListener('click', function (e) {
      var btn = e.target.closest('button[data-f]');
      if (!btn) return;
      e.preventDefault();
      setCat(btn.getAttribute('data-f'));
    });

    if (fine) {
      fine.addEventListener('click', function (e) {
        var btn = e.target.closest('button[data-p]');
        if (!btn) return;
        state.price = btn.getAttribute('data-p');
        render();
      });
    }
    if (stockBox) stockBox.addEventListener('change', function () { state.stock = stockBox.checked; render(); });

    // Delegated: the medal strip is drawn by zekulhyda.js after this script runs, so a
    // static querySelectorAll would miss those links.
    document.addEventListener('click', function (e) {
      var a = e.target.closest('a[data-f]');
      if (!a || bar.contains(a)) return;
      e.preventDefault();
      setCat(a.getAttribute('data-f'));
      var shop = document.getElementById('shop');
      if (shop) shop.scrollIntoView({ behavior: 'smooth' });
    });
  })();
</script>

{% schema %}
{
  "name": "Magazin",
  "settings": [
    {
      "type": "text",
      "id": "shop_eyebrow",
      "label": "Etichetă",
      "info": "Gol = textul tradus din locales/"
    },
    {
      "type": "textarea",
      "id": "shop_title",
      "label": "Titlu",
      "info": "Gol = textul tradus din locales/"
    },
    {
      "type": "textarea",
      "id": "shop_sub",
      "label": "Subtitlu",
      "info": "Gol = textul tradus din locales/"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Colecție sursă",
      "info": "Gol = toate produsele"
    },
    {
      "type": "text",
      "id": "filter_all",
      "label": "Etichetă „toate”",
      "info": "Gol = textul tradus din locales/"
    }
  ],
  "blocks": [
    {
      "type": "filter",
      "name": "Filtru",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Colecție"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Etichetă",
          "info": "Gol = numele colecției"
        },
        {
          "type": "checkbox",
          "id": "skip_order",
          "label": "Nu influențează ordinea",
          "default": false,
          "info": "Pentru categorii transversale (ex. Premiate): rămâne filtru, dar nu schimbă ordinea implicită a grilei."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Magazin — grilă produse"
    }
  ]
}
{% endschema %}
