{%- liquid
  assign col = section.settings.collection
  if col != blank
    assign items = col.products
  else
    assign items = collections.all.products
  endif
-%}

<section id="shop">
  <div class="wrap">
    <div class="sec-head reveal">
      <div class="eyebrow">{% render 'zk-t', override: section.settings.shop_eyebrow, key: 'zk.shop_eyebrow' %}</div>
      <h2>{% render 'zk-t', override: section.settings.shop_title, key: 'zk.shop_title' %}</h2>
      <p>{% render 'zk-t', override: section.settings.shop_sub, key: 'zk.shop_sub' %}</p>
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="filters">
        <a class="on" href="{{ routes.all_products_collection_url }}">{% render 'zk-t', override: section.settings.filter_all, key: 'zk.shop_all' %}</a>
        {%- for block in section.blocks -%}
          {%- assign fc = collections[block.settings.collection] -%}
          {%- if fc != blank -%}
            <a href="{{ fc.url }}" {{ block.shopify_attributes }}>{{ block.settings.label | default: fc.title }}</a>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    <div class="grid">
      {%- for product in items limit: section.settings.products_count -%}
        <div class="card reveal">
          <a class="pic{% if product.featured_image %} photo{% endif %}" href="{{ product.url }}">
            {% render 'zk-product-image', product: product %}
            {%- for tag in product.tags -%}
              {%- if tag contains 'badge:' -%}
                <span class="badge">{{ tag | remove: 'badge:' }}</span>
              {%- endif -%}
            {%- endfor -%}
          </a>

          <div class="body">
            <span class="fruit">{{ product.type | default: product.vendor }}</span>
            <h3><a href="{{ product.url }}">{{ product.title }}</a></h3>
            <p class="note">{{ product.description | strip_html | truncate: 96 }}</p>

            <div class="row">
              <div class="price">
                {{ product.price | money }}
                {%- if product.variants.first.title != 'Default Title' %}
                  <small>{{ product.variants.first.title }}</small>
                {%- endif %}
              </div>

              {%- if product.available -%}
                <form action="{{ routes.cart_add_url }}" method="post" enctype="multipart/form-data">
                  <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                  <input type="hidden" name="quantity" value="1">
                  <button type="submit" class="add">{% render 'zk-t', override: section.settings.add_label, key: 'products.add_to_cart' %}</button>
                </form>
              {%- else -%}
                <button class="add" disabled>{% render 'zk-t', override: section.settings.sold_label, key: 'products.sold_out' %}</button>
              {%- endif -%}
            </div>
          </div>
        </div>
      {%- else -%}
        <p class="empty">{{ 'collections.no_products' | t }}</p>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Magazin",
  "settings": [
    {
      "type": "text",
      "id": "shop_eyebrow",
      "label": "Etichetă",
      "info": "Gol = textul tradus din locales/"
    },
    {
      "type": "textarea",
      "id": "shop_title",
      "label": "Titlu",
      "info": "Gol = textul tradus din locales/"
    },
    {
      "type": "textarea",
      "id": "shop_sub",
      "label": "Subtitlu",
      "info": "Gol = textul tradus din locales/"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Colecție (gol = toate produsele)"
    },
    {
      "type": "range",
      "id": "products_count",
      "min": 4,
      "max": 40,
      "step": 4,
      "label": "Număr de produse",
      "default": 12
    },
    {
      "type": "text",
      "id": "filter_all",
      "label": "Etichetă „toate”",
      "info": "Gol = textul tradus din locales/"
    },
    {
      "type": "text",
      "id": "add_label",
      "label": "Buton adăugare",
      "default": "În coș"
    },
    {
      "type": "text",
      "id": "sold_label",
      "label": "Text epuizat",
      "default": "Epuizat"
    }
  ],
  "blocks": [
    {
      "type": "filter",
      "name": "Filtru (colecție)",
      "settings": [
        {
          "type": "text",
          "id": "collection",
          "label": "Handle colecție",
          "info": "ex. barrique"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Etichetă"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Magazin — grilă produse"
    }
  ]
}
{% endschema %}
