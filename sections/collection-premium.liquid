{%- liquid
  assign col = section.settings.collection
  if col != blank
    assign items = col.products
  else
    assign items = collections.all.products
  endif
-%}

<section id="shop">
  <div class="wrap">
    <div class="sec-head reveal">
      <div class="eyebrow">{% render 'zk-t', override: section.settings.shop_eyebrow, key: 'zk.shop_eyebrow' %}</div>
      <h2>{% render 'zk-t', override: section.settings.shop_title, key: 'zk.shop_title' %}</h2>
      <p>{% render 'zk-t', override: section.settings.shop_sub, key: 'zk.shop_sub' %}</p>
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="filters" id="zkFilters">
        <button type="button" class="on" data-f="*">
          {%- render 'zk-t', override: section.settings.filter_all, key: 'zk.shop_all' -%}
        </button>
        {%- for block in section.blocks -%}
          {%- assign fc = block.settings.collection -%}
          {%- if fc != blank -%}
            <button type="button" data-f="{{ fc.handle }}" {{ block.shopify_attributes }}>
              {{- block.settings.label | default: fc.title -}}
            </button>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    <div class="grid" id="zkGrid">
      {%- for product in items limit: section.settings.products_count -%}
        {%- capture handles -%}{%- for c in product.collections -%}{{ c.handle }} {% endfor -%}{%- endcapture -%}
        <div class="card reveal" data-c="{{ handles | strip }}">
          <a class="pic{% if product.featured_image %} photo{% endif %}" href="{{ product.url }}">
            {% render 'zk-product-image', product: product %}
            {% render 'zk-award-mini', product: product %}
            {%- for tag in product.tags -%}
              {%- if tag contains 'badge:' -%}
                <span class="badge">{{ tag | remove: 'badge:' }}</span>
              {%- endif -%}
            {%- endfor -%}
          </a>

          <div class="body">
            <span class="fruit">{{ product.type | default: product.vendor }}</span>
            <h3><a href="{{ product.url }}">{{ product.title }}</a></h3>
            <p class="note">{{ product.description | strip_html | truncate: 96 }}</p>

            <div class="row">
              <div class="price">
                {{ product.price | money }}
                {%- if product.variants.first.title != 'Default Title' %}
                  <small>{{ product.variants.first.title }}</small>
                {%- endif %}
              </div>

              {%- if product.available -%}
                <form action="{{ routes.cart_add_url }}" method="post" enctype="multipart/form-data">
                  <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                  <input type="hidden" name="quantity" value="1">
                  <button type="submit" class="add">{%- render 'zk-t', override: section.settings.add_label, key: 'products.add_to_cart' -%}</button>
                </form>
              {%- else -%}
                <button class="add" disabled>{%- render 'zk-t', override: section.settings.sold_label, key: 'products.sold_out' -%}</button>
              {%- endif -%}
            </div>
          </div>
        </div>
      {%- else -%}
        <p class="empty">{{ 'collections.no_products' | t }}</p>
      {%- endfor -%}
    </div>

    <p class="zk-noresult" id="zkNoResult" hidden>{{ 'collections.no_products' | t }}</p>
  </div>
</section>

<script>
  (function () {
    var bar = document.getElementById('zkFilters');
    var grid = document.getElementById('zkGrid');
    if (!bar || !grid) return;

    var cards = [].slice.call(grid.querySelectorAll('.card'));
    var empty = document.getElementById('zkNoResult');

    // The range tiers and the Barrique / Distilat calls to action link here using the
    // design's own data-f values, which do not all match the collection handles.
    var ALIAS = { distilat: 'distilat-sticla-albastra' };

    function apply(value) {
      var want = ALIAS[value] || value;
      var shown = 0;

      cards.forEach(function (card) {
        var hit = want === '*' ||
          (' ' + (card.getAttribute('data-c') || '') + ' ').indexOf(' ' + want + ' ') > -1;
        card.hidden = !hit;
        if (hit) shown++;
      });

      if (empty) empty.hidden = shown > 0;

      [].slice.call(bar.querySelectorAll('button')).forEach(function (b) {
        var v = b.getAttribute('data-f');
        b.classList.toggle('on', (ALIAS[v] || v) === want);
      });
    }

    bar.addEventListener('click', function (e) {
      var btn = e.target.closest('button[data-f]');
      if (!btn) return;
      e.preventDefault();
      apply(btn.getAttribute('data-f'));
    });

    document.querySelectorAll('a[data-f]').forEach(function (a) {
      a.addEventListener('click', function (e) {
        e.preventDefault();
        apply(a.getAttribute('data-f'));
        var shop = document.getElementById('shop');
        if (shop) shop.scrollIntoView({ behavior: 'smooth' });
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Magazin",
  "settings": [
    { "type": "text", "id": "shop_eyebrow", "label": "Etichetă", "info": "Gol = textul tradus din locales/" },
    { "type": "textarea", "id": "shop_title", "label": "Titlu", "info": "Gol = textul tradus din locales/" },
    { "type": "textarea", "id": "shop_sub", "label": "Subtitlu", "info": "Gol = textul tradus din locales/" },
    { "type": "collection", "id": "collection", "label": "Colecție sursă", "info": "Gol = toate produsele" },
    { "type": "range", "id": "products_count", "min": 4, "max": 40, "step": 4, "label": "Număr de produse", "default": 40, "info": "Filtrele lucrează pe produsele afișate, deci lăsați valoarea mare." },
    { "type": "text", "id": "filter_all", "label": "Etichetă „toate”", "info": "Gol = textul tradus din locales/" },
    { "type": "text", "id": "add_label", "label": "Buton adăugare", "info": "Gol = textul tradus din locales/" },
    { "type": "text", "id": "sold_label", "label": "Text epuizat", "info": "Gol = textul tradus din locales/" }
  ],
  "blocks": [
    {
      "type": "filter",
      "name": "Filtru",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Colecție" },
        { "type": "text", "id": "label", "label": "Etichetă", "info": "Gol = numele colecției" }
      ]
    }
  ],
  "presets": [{ "name": "Magazin — grilă produse" }]
}
{% endschema %}
