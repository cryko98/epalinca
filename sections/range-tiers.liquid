<section id="range"><div class="wrap">
  <div class="sec-head reveal"><div class="eyebrow">{% render 'zk-t', override: section.settings.range_eyebrow, key: 'zk.range_eyebrow' %}</div><h2>{% render 'zk-t', override: section.settings.range_title, key: 'zk.range_title' %}</h2><p>{% render 'zk-t', override: section.settings.range_sub, key: 'zk.range_sub' %}</p></div>
  <div class="tiers">
    <div class="tier reveal" style="--bg:url({{ 'zk-02.jpg' | asset_url }})"><span class="idx">01</span><div class="sw" style="background:#E8C872"></div><h3>{% render 'zk-t', override: section.settings.tier_core, key: 'zk.tier_core' %}</h3><p>{% render 'zk-t', override: section.settings.tier_core_d, key: 'zk.tier_core_d' %}</p><a href="#shop" data-f="core">88 lei</a></div>
    <div class="tier reveal" style="--bg:url({{ 'zk-03.jpg' | asset_url }})"><span class="idx">02</span><div class="sw" style="background:#5B2A3A"></div><h3>{% render 'zk-t', override: section.settings.tier_varietal, key: 'zk.tier_varietal' %}</h3><p>{% render 'zk-t', override: section.settings.tier_varietal_d, key: 'zk.tier_varietal_d' %}</p><a href="#shop" data-f="varietal">88 lei</a></div>
    <div class="tier reveal" style="--bg:url({{ 'zk-04.jpg' | asset_url }})"><span class="idx">03</span><div class="sw" style="background:#F0A24B"></div><h3>{% render 'zk-t', override: section.settings.tier_orchard, key: 'zk.tier_orchard' %}</h3><p>{% render 'zk-t', override: section.settings.tier_orchard_d, key: 'zk.tier_orchard_d' %}</p><a href="#shop" data-f="orchard">105–132 lei</a></div>
    <div class="tier reveal" style="--bg:url({{ 'zk-05.jpg' | asset_url }})"><span class="idx">04</span><div class="sw" style="background:#2A3A6B"></div><h3>{% render 'zk-t', override: section.settings.tier_wild, key: 'zk.tier_wild' %}</h3><p>{% render 'zk-t', override: section.settings.tier_wild_d, key: 'zk.tier_wild_d' %}</p><a href="#shop" data-f="wild">180–220 lei</a></div>
    <div class="tier reveal" style="--bg:url({{ 'zk-06.jpg' | asset_url }})"><span class="idx">05</span><div class="sw" style="background:#C9963B"></div><h3>{% render 'zk-t', override: section.settings.tier_champion, key: 'zk.tier_champion' %}</h3><p>{% render 'zk-t', override: section.settings.tier_champion_d, key: 'zk.tier_champion_d' %}</p><a href="#shop" data-f="champion">132–220 lei</a></div>
    <div class="tier reveal" style="--bg:url({{ 'zk-07.jpg' | asset_url }})"><span class="idx">06</span><div class="sw" style="background:#B0742A"></div><h3>{% render 'zk-t', override: section.settings.tier_barrique, key: 'zk.tier_barrique' %}</h3><p>{% render 'zk-t', override: section.settings.tier_barrique_d, key: 'zk.tier_barrique_d' %}</p><a href="#shop" data-f="barrique">200–220 lei</a></div>
    <div class="tier reveal" style="--bg:url({{ 'zk-08.jpg' | asset_url }})"><span class="idx">07</span><div class="sw" style="background:#2FB3C9"></div><h3>{% render 'zk-t', override: section.settings.tier_distilat, key: 'zk.tier_distilat' %}</h3><p>{% render 'zk-t', override: section.settings.tier_distilat_d, key: 'zk.tier_distilat_d' %}</p><a href="#shop" data-f="distilat">120 lei</a></div>
  </div>
</div></section>

