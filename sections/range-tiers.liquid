<section id="range"><div class="wrap">
  <div class="sec-head reveal"><div class="eyebrow">{% render 'zk-t', override: section.settings.range_eyebrow, key: 'zk.range_eyebrow' %}</div><h2>{% if settings.show_distilat %}{% render 'zk-t', override: section.settings.range_title, key: 'zk.range_title_six' %}{% else %}{% render 'zk-t', override: section.settings.range_title, key: 'zk.range_title_five' %}{% endif %}</h2><p>{% if settings.show_distilat %}{% render 'zk-t', override: section.settings.range_sub, key: 'zk.range_sub' %}{% else %}{% render 'zk-t', override: section.settings.range_sub, key: 'zk.range_sub_short' %}{% endif %}</p></div>
  <div class="tiers">
    <a class="tier reveal" href="#shop" data-f="fructe" style="--bg:url({{ 'zk-tier-fruit.jpg' | asset_url }})"><span class="idx">01</span><div class="sw" style="background:#F0A24B"></div><h3>{% render 'zk-t', override: section.settings.tier_orchard, key: 'zk.tier_orchard' %}</h3><p>{% render 'zk-t', override: section.settings.tier_orchard_d, key: 'zk.tier_orchard_d' %}</p><span class="more">77–118 lei</span></a>
    <a class="tier reveal" href="#shop" data-f="struguri" style="--bg:url({{ 'zk-tier-grape.jpg' | asset_url }})"><span class="idx">02</span><div class="sw" style="background:#7B2D3B"></div><h3>{% render 'zk-t', override: section.settings.tier_varietal, key: 'zk.tier_varietal' %}</h3><p>{% render 'zk-t', override: section.settings.tier_varietal_d, key: 'zk.tier_varietal_d' %}</p><span class="more">77 lei</span></a>
    <a class="tier reveal" href="#shop" data-f="wild" style="--bg:url({{ 'zk-tier-wild.jpg' | asset_url }})"><span class="idx">03</span><div class="sw" style="background:#B5305C"></div><h3>{% render 'zk-t', override: section.settings.tier_wild, key: 'zk.tier_wild' %}</h3><p>{% render 'zk-t', override: section.settings.tier_wild_d, key: 'zk.tier_wild_d' %}</p><span class="more">118–192 lei</span></a>
    <a class="tier reveal" href="#shop" data-f="premiate" style="--bg:url({{ 'zk-tier-champ.jpg' | asset_url }})"><span class="idx">04</span><div class="sw" style="background:#C9963B"></div><h3>{% render 'zk-t', override: section.settings.tier_champion, key: 'zk.tier_champion' %}</h3><p>{% render 'zk-t', override: section.settings.tier_champion_d, key: 'zk.tier_champion_d' %}</p><span class="more">77–183 lei</span></a>
    <a class="tier reveal" href="#shop" data-f="barrique" style="--bg:url({{ 'zk-tier-barrique.jpg' | asset_url }})"><span class="idx">05</span><div class="sw" style="background:#B0742A"></div><h3>{% render 'zk-t', override: section.settings.tier_barrique, key: 'zk.tier_barrique' %}</h3><p>{% render 'zk-t', override: section.settings.tier_barrique_d, key: 'zk.tier_barrique_d' %}</p><span class="more">130–180 lei</span></a>
    {%- if settings.show_distilat -%}
    <a class="tier reveal" href="#shop" data-f="distilat-sticla-albastra" style="--bg:url({{ 'zk-08.jpg' | asset_url }})"><span class="idx">06</span><div class="sw" style="background:#2FB3C9"></div><h3>{% render 'zk-t', override: section.settings.tier_distilat, key: 'zk.tier_distilat' %}</h3><p>{% render 'zk-t', override: section.settings.tier_distilat_d, key: 'zk.tier_distilat_d' %}</p><span class="more">120 lei</span></a>
    {%- endif -%}
  </div>
</div></section>

