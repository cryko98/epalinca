{%- liquid
  assign count = collection.products_count
  if count == 1
    assign word = 'zk.product_one' | t
  else
    assign word = 'zk.product_many' | t
  endif
  assign meta = count | append: ' ' | append: word
-%}

{%- comment -%}
  Metafields are not translatable on this plan, so the Romanian field has HU/EN siblings
  (subtitle_hu, seo_text_en …) and the storefront language picks the right one, falling
  back to Romanian when a translation is missing.
{%- endcomment -%}
{%- liquid
  assign lead = collection.description
  assign eyebrow = 'zk.shop_eyebrow' | t
  assign cmf = collection.metafields.zekulhyda
  assign loc = request.locale.iso_code
  assign sub = cmf.subtitle.value
  assign seo_mf = cmf.seo_text
  if loc == 'hu'
    if cmf.subtitle_hu.value != blank
      assign sub = cmf.subtitle_hu.value
    endif
    if cmf.seo_text_hu.value != blank
      assign seo_mf = cmf.seo_text_hu
    endif
  elsif loc == 'en'
    if cmf.subtitle_en.value != blank
      assign sub = cmf.subtitle_en.value
    endif
    if cmf.seo_text_en.value != blank
      assign seo_mf = cmf.seo_text_en
    endif
  endif
  if sub != blank
    assign lead = sub
  endif
-%}
{% render 'zk-page-head',
   eyebrow: eyebrow,
   title: collection.title,
   lead: lead,
   meta: meta %}

<section class="zk-shop">
  <div class="wrap">

    {%- comment -%}
      Sibling categories, so a shopper can move between them without going back to the
      homepage. The current one is marked and not a link.
    {%- endcomment -%}
    {%- if settings.show_distilat -%}
      {%- assign cats = 'fructe,struguri,wild,premiate,barrique,distilat-sticla-albastra' | split: ',' -%}
    {%- else -%}
      {%- assign cats = 'fructe,struguri,wild,premiate,barrique' | split: ',' -%}
    {%- endif -%}
    <div class="filters">
      <a href="{{ routes.all_products_collection_url }}">{{ 'zk.shop_all' | t }}</a>
      {%- for h in cats -%}
        {%- assign c = collections[h] -%}
        {%- if c != blank and c.products_count > 0 -%}
          {%- if c.handle == collection.handle -%}
            <span class="on">{{ c.title }}</span>
          {%- else -%}
            <a href="{{ c.url }}">{{ c.title }}</a>
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- if collection.products.size > 0 -%}
      <form class="zk-sort" method="get">
        <label for="SortBy">{{ 'collections.sort_by' | t }}</label>
        {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
        <select name="sort_by" id="SortBy" onchange="this.form.submit()">
          {%- for option in collection.sort_options -%}
            <option value="{{ option.value }}" {% if option.value == sort_by %}selected{% endif %}>{{ option.name }}</option>
          {%- endfor -%}
        </select>
      </form>
    {%- endif -%}

    {% render 'zk-filters' %}

    {% paginate collection.products by 24 %}
      {%- if collection.products.size > 0 -%}
        <div class="grid">
          {%- for product in collection.products -%}
            <div class="card{% unless product.available %} card--soldout{% endunless %}">
              <a class="pic{% if product.featured_image %} photo{% endif %}" href="{{ product.url }}">
                {% render 'zk-product-image', product: product %}
                {%- unless product.available -%}<span class="soldout-tag">{{ 'products.sold_out' | t }}</span>{%- endunless -%}
                {% render 'zk-award-mini', product: product %}
                {%- for tag in product.tags -%}
                  {%- if tag contains 'badge:' -%}
                    <span class="badge">{{ tag | remove: 'badge:' }}</span>
                  {%- endif -%}
                {%- endfor -%}
              </a>
              <div class="body">
                <span class="fruit">{{ product.type | default: product.vendor }}</span>
                <h3><a href="{{ product.url }}">{{ product.title }}</a></h3>
                <p class="note">{{ product.description | strip_html | truncate: 96 }}</p>
                <div class="row">
                  <div class="price">{{ product.price | money }}</div>
                  {%- if product.available -%}
                    <form action="{{ routes.cart_add_url }}" method="post" enctype="multipart/form-data">
                      <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                      <input type="hidden" name="quantity" value="1">
                      <button type="submit" class="add">{{ 'products.add_to_cart' | t }}</button>
                    </form>
                  {%- else -%}
                    <button class="add" disabled>{{ 'products.sold_out' | t }}</button>
                  {%- endif -%}
                </div>
              </div>
            </div>
          {%- endfor -%}
        </div>
      {%- else -%}
        <p class="empty">{{ 'collections.no_products' | t }}</p>
      {%- endif -%}

      {%- if paginate.pages > 1 -%}
        <div class="zk-pager">{{ paginate | default_pagination }}</div>
      {%- endif -%}
    {% endpaginate %}

    {%- comment -%}
      Category copy for search engines and shoppers who read: the rich-text
      zekulhyda.seo_text metafield below the grid, then the FAQ (also FAQPage schema).
    {%- endcomment -%}
    {%- if seo_mf.value != blank -%}
      <div class="zk-seotext rte">{{ seo_mf | metafield_tag }}</div>
    {%- endif -%}
    {% render 'zk-faq', items: collection.metafields.zekulhyda.faq.value %}

  </div>
</section>

{% schema %}
{"name": "Main Colectie", "settings": []}
{% endschema %}
