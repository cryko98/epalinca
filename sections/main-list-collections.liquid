<div class="collections-page" style="padding-top:80px;">

  <div class="collections-page__hero">
    <div class="section-inner">
      <div class="section-label">
        <span class="section-label-line"></span>
        <span class="section-label-text">{% render 'zk-t', override: section.settings.label, key: 'zk.collections_label' %}</span>
      </div>
      <h1 class="collections-page__title">{{ page_title }}</h1>
    </div>
  </div>

  <div class="section-inner collections-page__body">
    <div class="collections-grid">
      {%- for collection in collections -%}
        <a href="{{ collection.url }}" class="collection-tile">
          <div class="collection-tile__media">
            {%- if collection.featured_image -%}
              <img src="{{ collection.featured_image | image_url: width: 800 }}"
                   alt="{{ collection.title | escape }}"
                   width="{{ collection.featured_image.width }}" height="{{ collection.featured_image.height }}"
                   loading="lazy">
            {%- else -%}
              {% render 'bottle-svg', color: 'premium' %}
            {%- endif -%}
            <span class="collection-tile__veil"></span>
          </div>
          <div class="collection-tile__info">
            <h2 class="collection-tile__name">{{ collection.title }}</h2>
            <p class="collection-tile__count">
              {{ collection.all_products_count }}
              {%- if collection.all_products_count == 1 %} produs{% else %} produse{% endif -%}
            </p>
          </div>
        </a>
      {%- else -%}
        <p class="collections-page__empty">Nu există colecții publicate încă.</p>
      {%- endfor -%}
    </div>
  </div>
</div>

<style>
.collections-page__hero { padding:80px 0 40px; border-bottom:1px solid rgba(240,234,216,.06); }
.collections-page__title { font-family:var(--font-display); font-size:clamp(40px,4vw,64px); font-weight:400; color:var(--color-cream); margin-top:14px; }
.collections-page__body { padding:64px 0 120px; }
.collections-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(300px,1fr)); gap:28px; }
.collection-tile { display:block; border:1px solid var(--color-line); background:var(--color-graphite); transition:border-color .3s ease; }
.collection-tile:hover { border-color:var(--color-gold-lo); }
.collection-tile__media { position:relative; aspect-ratio:4/3; overflow:hidden; background:var(--color-slate); }
.collection-tile__media img { width:100%; height:100%; object-fit:cover; transition:transform .6s ease; }
.collection-tile:hover .collection-tile__media img { transform:scale(1.04); }
.collection-tile__veil { position:absolute; inset:0; background:linear-gradient(to top, rgba(11,11,12,.75), transparent 55%); }
.collection-tile__info { padding:24px; }
.collection-tile__name { font-family:var(--font-display); font-size:26px; font-weight:400; color:var(--color-cream); }
.collection-tile:hover .collection-tile__name { color:var(--color-gold); }
.collection-tile__count { font-family:var(--font-mono); font-size:11px; letter-spacing:.1em; text-transform:uppercase; color:var(--color-fog); margin-top:8px; }
.collections-page__empty { font-family:var(--font-serif); font-style:italic; font-size:17px; color:var(--color-cream-dim); }
</style>

{% schema %}
{
  "name": "Main Colectii",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Etichetă",
      "info": "Gol = textul tradus din locales/"
    }
  ]
}
{% endschema %}
