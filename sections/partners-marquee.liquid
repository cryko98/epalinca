<section id="partners">
  <div class="wrap">
    <div class="sec-head reveal">
      <div class="eyebrow">{% render 'zk-t', override: section.settings.partners_eyebrow, key: 'zk.partners_eyebrow' %}</div>
      <h2>{% render 'zk-t', override: section.settings.partners_title, key: 'zk.partners_title' %}</h2>
      <p>{% render 'zk-t', override: section.settings.partners_sub, key: 'zk.partners_sub' %}</p>
    </div>
  </div>
  {%- comment -%}
    The scrolling track is filled by assets/zekulhyda.js from its PARTNERS list, duplicated
    so the marquee loops seamlessly — same as the reference design.
  {%- endcomment -%}
  <div class="marquee"><div class="track" id="ptrack"></div></div>
</section>

{% schema %}
{
  "name": "Parteneri",
  "settings": [
    {
      "type": "text",
      "id": "partners_eyebrow",
      "label": "Etichetă",
      "info": "Gol = textul tradus din locales/"
    },
    {
      "type": "textarea",
      "id": "partners_title",
      "label": "Titlu",
      "info": "Gol = textul tradus din locales/"
    },
    {
      "type": "textarea",
      "id": "partners_sub",
      "label": "Subtitlu",
      "info": "Gol = textul tradus din locales/"
    },
    {
      "type": "paragraph",
      "content": "Lista partenerilor se editează în assets/zekulhyda.js (constanta PARTNERS)."
    }
  ],
  "presets": [
    {
      "name": "Parteneri"
    }
  ]
}
{% endschema %}
