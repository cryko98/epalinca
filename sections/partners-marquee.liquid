<section id="partners">
  <div class="wrap">
    <div class="sec-head reveal">
      <div class="eyebrow">{{ section.settings.partners_eyebrow }}</div>
      <h2>{{ section.settings.partners_title }}</h2>
      <p>{{ section.settings.partners_sub }}</p>
    </div>
  </div>
  {%- comment -%}
    The scrolling track is filled by assets/zekulhyda.js from its PARTNERS list, duplicated
    so the marquee loops seamlessly — same as the reference design.
  {%- endcomment -%}
  <div class="marquee"><div class="track" id="ptrack"></div></div>
</section>

{% schema %}
{
  "name": "Parteneri",
  "settings": [
    { "type": "text", "id": "partners_eyebrow", "label": "Etichetă", "default": "Unde ne găsești" },
    { "type": "textarea", "id": "partners_title", "label": "Titlu", "default": "Restaurante, baruri de vin, <em>magazine online.</em>" },
    { "type": "textarea", "id": "partners_sub", "label": "Subtitlu", "default": "Pălincile Zekulhyda se găsesc și la partenerii de mai jos." },
    { "type": "paragraph", "content": "Lista partenerilor se editează în assets/zekulhyda.js (constanta PARTNERS)." }
  ],
  "presets": [{ "name": "Parteneri" }]
}
{% endschema %}
