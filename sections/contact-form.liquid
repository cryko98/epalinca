<div class="contact-section">
  <div class="section-inner contact-section__inner">

    {%- if section.settings.title != blank %}
      <h2 class="contact-section__title">{{ section.settings.title }}</h2>
    {%- endif %}

    {% form 'contact', class: 'contact-form' %}
      {%- if form.posted_successfully? %}
        <p class="contact-form__success">
          {{ section.settings.success_text | default: 'Mulțumim! Mesajul a fost trimis, revenim în cel mai scurt timp.' }}
        </p>
      {%- endif %}

      {%- if form.errors %}
        <div class="contact-form__errors">
          {%- for field in form.errors %}
            <p>{{ form.errors.messages[field] }}</p>
          {%- endfor %}
        </div>
      {%- endif %}

      <div class="contact-form__row">
        <div class="contact-form__field">
          <label for="ContactName">Nume</label>
          <input type="text" id="ContactName" name="contact[name]" value="{{ form.name }}" autocomplete="name">
        </div>
        <div class="contact-form__field">
          <label for="ContactEmail">E-mail <span aria-hidden="true">*</span></label>
          <input type="email" id="ContactEmail" name="contact[email]" value="{{ form.email }}" autocomplete="email" required>
        </div>
      </div>

      <div class="contact-form__field">
        <label for="ContactPhone">Telefon</label>
        <input type="tel" id="ContactPhone" name="contact[phone]" value="{{ form.phone }}" autocomplete="tel">
      </div>

      <div class="contact-form__field">
        <label for="ContactBody">Mesaj <span aria-hidden="true">*</span></label>
        <textarea id="ContactBody" name="contact[body]" rows="7" required>{{ form.body }}</textarea>
      </div>

      <button type="submit" class="btn-primary contact-form__submit">
        {{ section.settings.button_label | default: 'Trimite mesajul' }}
      </button>
    {% endform %}

  </div>
</div>

<style>
.contact-section__inner { padding:64px 0 120px; max-width:760px; }
.contact-section__title { font-family:var(--font-display); font-size:clamp(28px,3vw,40px); font-weight:400; color:var(--color-cream); margin-bottom:32px; }
.contact-form__row { display:grid; grid-template-columns:1fr 1fr; gap:20px; }
@media (max-width:640px) { .contact-form__row { grid-template-columns:1fr; } }
.contact-form__field { margin-bottom:20px; }
.contact-form__field label { display:block; font-family:var(--font-mono); font-size:11px; letter-spacing:.12em; text-transform:uppercase; color:var(--color-fog); margin-bottom:8px; }
.contact-form__field input, .contact-form__field textarea {
  width:100%; background:var(--color-graphite); border:1px solid var(--color-line); border-radius:2px;
  padding:13px 14px; color:var(--color-cream); font-family:var(--font-body); font-size:15px;
}
.contact-form__field input:focus, .contact-form__field textarea:focus { outline:none; border-color:var(--color-gold-lo); }
.contact-form__submit { margin-top:8px; }
.contact-form__success { border:1px solid var(--color-gold-lo); background:rgba(201,150,59,.08); color:var(--color-gold-hi); padding:16px 18px; margin-bottom:28px; font-family:var(--font-serif); font-style:italic; }
.contact-form__errors { border:1px solid #7a2727; background:rgba(160,50,50,.1); color:#e8a1a1; padding:16px 18px; margin-bottom:28px; font-size:14px; }
</style>

{% schema %}
{
  "name": "Formular contact",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Titlu",
      "default": "Scrieți-ne"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Text buton",
      "default": "Trimite mesajul"
    },
    {
      "type": "textarea",
      "id": "success_text",
      "label": "Mesaj de succes",
      "default": "Mulțumim! Mesajul a fost trimis, revenim în cel mai scurt timp."
    }
  ],
  "presets": [
    {
      "name": "Formular contact"
    }
  ]
}
{% endschema %}
