<section class="hero" id="top">
  <div class="bg" id="slides"></div>
  <div class="wrap">
    <div>
      <div class="eyebrow">{% render 'zk-t', override: section.settings.hero_eyebrow, key: 'zk.hero_eyebrow' %}</div>
      <h1 style="margin-top:.8rem">{% render 'zk-t', override: section.settings.hero_title, key: 'zk.hero_title' %}</h1>
      <p class="lead">{% render 'zk-t', override: section.settings.hero_sub, key: 'zk.hero_sub' %}</p>
      <div class="ctas">
        <a class="btn primary" href="{{ section.settings.cta_link | default: '#shop' }}">{% render 'zk-t', override: section.settings.hero_cta, key: 'zk.hero_cta' %}</a>
        <a class="btn" href="{{ section.settings.cta2_link | default: '#story' }}">{% render 'zk-t', override: section.settings.hero_cta2, key: 'zk.hero_cta2' %}</a>
      </div>
    </div>
  </div>

  <div class="slidebar">
    <div class="wrap">
      <div class="cap">
        <span class="num" id="slNum">01 / 04</span>
        <span class="ttl" id="slTitle"></span>
      </div>
      <a class="btn primary" id="slCta" href="{{ section.settings.cta_link | default: '#shop' }}"></a>
      <div class="nav">
        <button class="arr" id="slPrev" aria-label="{{ 'zk.slide_prev' | t }}">←</button>
        <div class="dots" id="slDots"></div>
        <button class="arr" id="slNext" aria-label="{{ 'zk.slide_next' | t }}">→</button>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "text",
      "id": "hero_eyebrow",
      "label": "Etichetă",
      "info": "Gol = textul tradus din locales/"
    },
    {
      "type": "textarea",
      "id": "hero_title",
      "label": "Titlu",
      "info": "Gol = textul tradus din locales/"
    },
    {
      "type": "textarea",
      "id": "hero_sub",
      "label": "Subtitlu",
      "info": "Gol = textul tradus din locales/"
    },
    {
      "type": "text",
      "id": "hero_cta",
      "label": "Buton principal",
      "info": "Gol = textul tradus din locales/"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Link buton principal"
    },
    {
      "type": "text",
      "id": "hero_cta2",
      "label": "Buton secundar",
      "info": "Gol = textul tradus din locales/"
    },
    {
      "type": "url",
      "id": "cta2_link",
      "label": "Link buton secundar"
    },
    {
      "type": "paragraph",
      "content": "Imaginile din slideshow vin din design (zk-42…zk-45) și sunt încărcate ca fișiere ale temei."
    }
  ],
  "presets": [
    {
      "name": "Hero cu slideshow"
    }
  ]
}
{% endschema %}
