<section id="story"><div class="wrap">
  <div class="text reveal"><div class="eyebrow">{% render 'zk-t', override: section.settings.story_eyebrow, key: 'zk.story_eyebrow' %}</div><h2 style="margin:.6rem 0 1.4rem">{% render 'zk-t', override: section.settings.story_title, key: 'zk.story_title' %}</h2><p>{% render 'zk-t', override: section.settings.story_p1, key: 'zk.story_p1' %}</p><p>{% render 'zk-t', override: section.settings.story_p2, key: 'zk.story_p2' %}</p><p>{% render 'zk-t', override: section.settings.story_p3, key: 'zk.story_p3' %}</p><blockquote>{% render 'zk-t', override: section.settings.story_quote, key: 'zk.story_quote' %}</blockquote>
    <div class="timeline"><div><b>2014</b><span>{% render 'zk-t', override: section.settings.tl_2014, key: 'zk.tl_2014' %}</span></div><div><b>2018</b><span>{% render 'zk-t', override: section.settings.tl_2018, key: 'zk.tl_2018' %}</span></div><div><b>2020</b><span>{% render 'zk-t', override: section.settings.tl_2020, key: 'zk.tl_2020' %}</span></div><div><b>2025</b><span>{% render 'zk-t', override: section.settings.tl_2025, key: 'zk.tl_2025' %}</span></div><div><b>2026</b><span>{% render 'zk-t', override: section.settings.tl_2026, key: 'zk.tl_2026' %}</span></div></div>
  </div>
  <div class="photos reveal">
    <figure><img src="{{ 'zk-17.jpg' | asset_url }}" alt="Nagy Botond on stage at Quintessence 2026"><figcaption>{% render 'zk-t', override: section.settings.cap_stage, key: 'zk.cap_stage' %}</figcaption></figure>
    <figure><img src="{{ 'zk-18.jpg' | asset_url }}" alt="Nagy Botond receiving the ÁKOVITA award"><figcaption>{% render 'zk-t', override: section.settings.cap_award, key: 'zk.cap_award' %}</figcaption></figure>
    <figure><img src="{{ 'zk-19.jpg' | asset_url }}" alt="Nagy Botond nosing a glass while judging"><figcaption>{% render 'zk-t', override: section.settings.cap_nose, key: 'zk.cap_nose' %}</figcaption></figure>
  </div>
</div></section>

