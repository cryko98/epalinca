{%- liquid
  assign v = product.selected_or_first_available_variant
  assign home_col = product.collections | first

  assign abv = ''
  assign vol = ''
  for tag in product.tags
    if tag contains 'abv:'
      assign abv = tag | remove: 'abv:'
    endif
    if tag contains 'vol:'
      assign vol = tag | remove: 'vol:'
    endif
  endfor
-%}

<section class="pdp">
  <div class="wrap">

    <nav class="pdp__crumbs" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}">{{ 'zk.nav_home' | t }}</a>
      <span>—</span>
      {%- if home_col != blank -%}
        <a href="{{ home_col.url }}">{{ home_col.title }}</a>
        <span>—</span>
      {%- endif -%}
      <span aria-current="page">{{ product.title }}</span>
    </nav>

    <div class="pdp__top">

      <div class="pdp__media">
        <div class="pdp__stage">
          {%- if product.featured_image -%}
            <img id="MainImg"
                 src="{{ product.featured_image | image_url: width: 1100 }}"
                 width="{{ product.featured_image.width }}" height="{{ product.featured_image.height }}"
                 alt="{{ product.title | escape }}" loading="eager">
          {%- else -%}
            {% render 'bottle-svg', color: 'premium' %}
          {%- endif -%}
          {% render 'zk-award-mini', product: product %}
        </div>

        {%- if product.images.size > 1 -%}
          <div class="pdp__thumbs">
            {%- for image in product.images -%}
              <button type="button" class="pdp__thumb{% if forloop.first %} on{% endif %}"
                      data-full="{{ image | image_url: width: 1100 }}"
                      aria-label="{{ product.title | escape }} {{ forloop.index }}">
                <img src="{{ image | image_url: width: 160 }}" alt="" loading="lazy" width="80" height="100">
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <div class="pdp__info reveal">
        <div class="eyebrow">
          {{- product.vendor -}}
          {%- if product.type != blank %} · {{ product.type }}{% endif -%}
        </div>

        <h1 class="pdp__title">{{ product.title }}</h1>

        {%- for tag in product.tags -%}
          {%- if tag contains 'badge:' -%}
            <span class="pdp__badge">{{ tag | remove: 'badge:' }}</span>
          {%- endif -%}
        {%- endfor -%}

        <div class="pdp__price">
          {%- if product.compare_at_price_max > product.price -%}
            <s>{{ product.compare_at_price_max | money }}</s>
          {%- endif -%}
          <span class="pdp__price-now">{{ product.price | money }}</span>
          {%- if vol != blank %}<small>{{ vol }} ml</small>{% endif -%}
        </div>

        <form action="{{ routes.cart_add_url }}" method="post" enctype="multipart/form-data" class="pdp__buy" id="ProductForm">
          <input type="hidden" name="id" id="VariantId" value="{{ v.id }}">

          {%- unless product.has_only_default_variant -%}
            <div class="pdp__variants">
              {%- for option in product.options_with_values -%}
                <label class="pdp__field">
                  <span>{{ option.name }}</span>
                  <select data-opt="{{ option.position }}">
                    {%- for value in option.values -%}
                      <option value="{{ value | escape }}" {% if option.selected_value == value %}selected{% endif %}>{{ value }}</option>
                    {%- endfor -%}
                  </select>
                </label>
              {%- endfor -%}
            </div>
          {%- endunless -%}

          <div class="pdp__row">
            <div class="pdp__qty">
              <button type="button" data-step="-1" aria-label="−">−</button>
              <input type="number" name="quantity" id="Qty" value="1" min="1" max="99" aria-label="{{ 'products.quantity' | t }}">
              <button type="button" data-step="1" aria-label="+">+</button>
            </div>

            {%- if product.available -%}
              <button type="submit" class="btn primary pdp__add">{{ 'products.add_to_cart' | t }}</button>
            {%- else -%}
              <button type="button" class="btn pdp__add" disabled>{{ 'products.sold_out' | t }}</button>
            {%- endif -%}
          </div>
        </form>

        <ul class="pdp__specs">
          {%- if vol != blank -%}<li><b>{{ vol }} ml</b><span>{{ 'zk.spec_volume' | t }}</span></li>{%- endif -%}
          {%- if abv != blank -%}<li><b>{{ abv }}%</b><span>{{ 'zk.spec_abv' | t }}</span></li>{%- endif -%}
          <li><b>Valea Ierului</b><span>{{ 'zk.spec_region' | t }}</span></li>
          {%- if v.sku != blank -%}<li><b>{{ v.sku }}</b><span>{{ 'products.sku' | t }}</span></li>{%- endif -%}
        </ul>

        {% render 'zk-awards', product: product %}

        <div class="pdp__rte">{{ product.description }}</div>

        <p class="pdp__warning">{{ settings.alcohol_warning | default: 'Consumul de alcool în exces dăunează sănătății. Interzis minorilor.' }}</p>
      </div>
    </div>

    {%- if home_col != blank and home_col.products.size > 1 -%}
      <div class="pdp__more">
        <div class="sec-head">
          <div class="eyebrow">{{ home_col.title }}</div>
          <h2>{{ 'zk.pdp_more' | t }}</h2>
        </div>
        <div class="grid">
          {%- for p in home_col.products limit: 4 -%}
            {%- unless p.id == product.id -%}
              <div class="card">
                <a class="pic{% if p.featured_image %} photo{% endif %}" href="{{ p.url }}">
                  {% render 'zk-product-image', product: p %}
                  {% render 'zk-award-mini', product: p %}
                </a>
                <div class="body">
                  <span class="fruit">{{ p.type | default: p.vendor }}</span>
                  <h3><a href="{{ p.url }}">{{ p.title }}</a></h3>
                  <div class="row">
                    <div class="price">{{ p.price | money }}</div>
                  </div>
                </div>
              </div>
            {%- endunless -%}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}

  </div>
</section>

<script>
  (function () {
    var form = document.getElementById('ProductForm');
    if (!form) return;

    var qty = document.getElementById('Qty');
    form.querySelectorAll('[data-step]').forEach(function (b) {
      b.addEventListener('click', function () {
        var n = parseInt(qty.value || '1', 10) + parseInt(b.getAttribute('data-step'), 10);
        qty.value = Math.min(99, Math.max(1, n));
      });
    });

    // Swap the main image from a thumbnail.
    var main = document.getElementById('MainImg');
    document.querySelectorAll('.pdp__thumb').forEach(function (t) {
      t.addEventListener('click', function () {
        if (!main) return;
        main.src = t.getAttribute('data-full');
        document.querySelectorAll('.pdp__thumb').forEach(function (x) { x.classList.remove('on'); });
        t.classList.add('on');
      });
    });

    // Keep the hidden variant id in step with the option selects.
    var VARIANTS = {{ product.variants | json }};
    var selects = [].slice.call(form.querySelectorAll('[data-opt]'));
    var idField = document.getElementById('VariantId');
    if (!selects.length || !idField) return;

    selects.forEach(function (s) {
      s.addEventListener('change', function () {
        var chosen = selects.map(function (x) { return x.value; });
        var match = VARIANTS.find(function (variant) {
          return chosen.every(function (val, i) { return variant.options[i] === val; });
        });
        if (!match) return;
        idField.value = match.id;

        var price = form.closest('.pdp__info').querySelector('.pdp__price-now');
        if (price && window.Shopify && Shopify.formatMoney) {
          price.textContent = Shopify.formatMoney(match.price);
        }
        var add = form.querySelector('.pdp__add');
        if (add) add.disabled = !match.available;
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Main Produs",
  "settings": []
}
{% endschema %}
