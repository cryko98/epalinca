{%- comment -%}
  Medal strip. The badges themselves (ring text, metal gradient, count) are drawn by
  assets/zekulhyda.js into #medals, exactly as in the reference design.
{%- endcomment -%}
<div class="medals">
  {% render 'zk-emblem' %}
  <div class="wrap" id="medals"></div>
  {%- comment -%}
    Link to the official Quintessence 2026 results. Their table (Ninja Tables) has no URL
    parameter for the search box, so we copy "Zekulhyda" to the clipboard on click and use a
    text fragment so supporting browsers jump to the first mention.
  {%- endcomment -%}
  <div class="wrap medals-cta">
    <a class="btn medals-cta__btn" id="medalsCta" href="{{ section.settings.results_url | default: 'https://quintessence-palinka.hu/eredmenyek/xvi-quintessence-2026/' }}#:~:text=Zekulhyda" target="_blank" rel="noopener">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 3h10v6a5 5 0 0 1-10 0zM7 5H4a3 3 0 0 0 3 4M17 5h3a3 3 0 0 1-3 4M12 14v4m-4 3h8"/></svg>
      {{ 'zk.md_results_btn' | t }}
    </a>
    <p class="medals-cta__hint" data-copied="{{ 'zk.md_results_copied' | t | escape }}">{{ 'zk.md_results_hint' | t }}</p>
  </div>
</div>
<script>
  (function () {
    var a = document.getElementById('medalsCta'); if (!a) return;
    a.addEventListener('click', function () {
      if (!navigator.clipboard) return;
      navigator.clipboard.writeText('Zekulhyda').then(function () {
        var h = a.nextElementSibling; if (!h) return;
        h.textContent = h.getAttribute('data-copied'); h.classList.add('is-copied');
      }).catch(function () {});
    });
  })();
</script>

{% schema %}
{
  "name": "Medalii",
  "settings": [
    {
      "type": "url",
      "id": "results_url",
      "label": "Link rezultate oficiale",
      "info": "Gol = pagina Quintessence 2026 (quintessence-palinka.hu/eredmenyek/xvi-quintessence-2026/)"
    },
    {
      "type": "paragraph",
      "content": "Medaliile și textele lor sunt definite în assets/zekulhyda.js (Quintessence, ÁKOVITA, maestrul soiului)."
    }
  ],
  "presets": [
    {
      "name": "Medalii"
    }
  ]
}
{% endschema %}
