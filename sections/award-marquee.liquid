<!-- Medal badges section — based on uploaded HTML medal data -->
<section class="medals">
  <div class="wrap">

    <!-- md1: Quintessence 2025 — 22 érem -->
    <a class="badge-m" href="{{ section.settings.story_url | default: '#story' }}">
      <svg viewBox="0 0 200 200" role="img" aria-label="Quintessence 2025 · 22 medalii">
        <defs>
          <linearGradient id="m1a" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#F6E3A1"/><stop offset=".5" stop-color="#C9963B"/><stop offset="1" stop-color="#7A5416"/>
          </linearGradient>
          <linearGradient id="m1b" x1="1" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#F6E3A1"/><stop offset=".55" stop-color="#C9963B"/><stop offset="1" stop-color="#7A5416"/>
          </linearGradient>
          <path id="m1p" d="M100,100 m-72,0 a72,72 0 1,1 144,0 a72,72 0 1,1 -144,0"/>
        </defs>
        <circle cx="100" cy="100" r="98" fill="url(#m1a)"/>
        <circle cx="100" cy="100" r="92" fill="none" stroke="#7A5416" stroke-opacity=".5" stroke-width="1"/>
        <circle cx="100" cy="100" r="88" fill="url(#m1b)"/>
        <circle cx="100" cy="100" r="58" fill="#0F0F11"/>
        <circle cx="100" cy="100" r="55" fill="none" stroke="#F6E3A1" stroke-opacity=".6" stroke-width=".8"/>
        <text font-family="IBM Plex Mono,monospace" font-size="9.5" letter-spacing="2.2" fill="#1a1408" font-weight="500">
          <textPath href="#m1p" startOffset="50%" text-anchor="middle">QUINTESSENCE 2025 · ONGA</textPath>
        </text>
        <text x="100" y="108" text-anchor="middle" font-family="Cormorant Garamond,serif" font-size="40" fill="#F6E3A1">22</text>
        <text x="100" y="130" text-anchor="middle" font-family="IBM Plex Mono,monospace" font-size="7.5" letter-spacing="1.6" fill="#C9963B">MEDALII</text>
        <path d="M40 40 q60 -40 120 0" fill="none" stroke="#fff" stroke-opacity=".35" stroke-width="6" stroke-linecap="round"/>
      </svg>
      <span class="medal-label">Quintessence 2025</span>
