<section class="section-newsletter" style="background:{{ section.settings.bg_color }};padding:{{ section.settings.padding }}px 60px;border-top:1px solid {{ section.settings.border_color }};">
  <div class="newsletter-inner reveal">
    <div>
      <p class="newsletter-eyebrow" style="color:{{ section.settings.accent_color }};">{{ section.settings.eyebrow }}</p>
      <h2 class="newsletter-title" style="color:{{ section.settings.title_color }};">{{ section.settings.title }}</h2>
      <p class="newsletter-subtitle" style="color:{{ section.settings.subtitle_color }};">{{ section.settings.subtitle }}</p>
    </div>
    <form class="newsletter-form" action="/contact#newsletter" method="post" accept-charset="UTF-8">
      <input type="hidden" name="form_type" value="customer">
      <input type="hidden" name="utf8" value="✓">
      <input type="hidden" name="contact[tags]" value="newsletter">
      <div class="newsletter-form__wrap">
        <input type="email" name="contact[email]"
          placeholder="{{ section.settings.placeholder | default: 'adresa@email.com' }}"
          class="newsletter-input"
          style="border-color:{{ section.settings.input_border }};background:{{ section.settings.input_bg }};color:{{ section.settings.title_color }};"
          required>
        <button type="submit" class="newsletter-btn" style="background:{{ section.settings.btn_bg }};color:{{ section.settings.btn_text }};">
          {% render 'zk-t', override: section.settings.btn_label, key: 'zk.nl_submit' %}
        </button>
      </div>
      <p class="newsletter-gdpr" style="color:{{ section.settings.gdpr_color }};">{{ section.settings.gdpr_text }}</p>
    </form>
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Text mic",
      "default": "Rămâi conectat"
    },
    {
      "type": "textarea",
      "id": "title",
      "label": "Titlu",
      "default": "Noutăți, Degustări & Oferte Exclusive"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitlu",
      "default": "Fii primul care află despre noile distilate, evenimentele Taste & Learning și promoțiile speciale."
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Placeholder câmp email",
      "default": "adresa@email.com"
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Text buton",
      "info": "Gol = textul tradus din locales/"
    },
    {
      "type": "textarea",
      "id": "gdpr_text",
      "label": "Text GDPR / confidențialitate",
      "default": "Prin abonare ești de acord cu Politica de Confidențialitate. Poți anula oricând."
    },
    {
      "type": "header",
      "content": "Culori"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Fundal",
      "default": "#161410"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Bordura sus",
      "default": "#28241c"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Culoare accent",
      "default": "#b8963e"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Culoare titlu",
      "default": "#f0ead8"
    },
    {
      "type": "color",
      "id": "subtitle_color",
      "label": "Culoare subtitlu",
      "default": "#a89878"
    },
    {
      "type": "color",
      "id": "input_bg",
      "label": "Fundal input",
      "default": "#0c0b09"
    },
    {
      "type": "color",
      "id": "input_border",
      "label": "Bordura input",
      "default": "#28241c"
    },
    {
      "type": "color",
      "id": "btn_bg",
      "label": "Fundal buton",
      "default": "#b8963e"
    },
    {
      "type": "color",
      "id": "btn_text",
      "label": "Text buton",
      "default": "#0c0b09"
    },
    {
      "type": "color",
      "id": "gdpr_color",
      "label": "Culoare text GDPR",
      "default": "#5a5040"
    },
    {
      "type": "range",
      "id": "padding",
      "min": 60,
      "max": 140,
      "step": 10,
      "unit": "px",
      "label": "Spațiu secțiune",
      "default": 100
    }
  ],
  "presets": [
    {
      "name": "Newsletter"
    }
  ]
}
{% endschema %}
