{%- liquid
  assign home = routes.root_url
  if template.name == 'index'
    assign base = ''
  else
    assign base = home
  endif
-%}

<header class="top">
  <div class="wrap">
    <a class="brand" href="{{ home }}" aria-label="{{ shop.name }}">{% render 'zk-logo' %}</a>

    {%- comment -%}
      The design hides nav.main below 860px and offered nothing in its place, so a phone
      had no navigation at all. This button opens the same links as a panel.
    {%- endcomment -%}
    <button type="button" class="zk-burger" id="zkBurger" aria-expanded="false" aria-controls="zkMobileNav"
            aria-label="{{ 'zk.nav_menu' | t }}">
      <span></span><span></span><span></span>
    </button>

    <nav class="main">
      {%- comment -%}
        Category menu: the five shop categories, so they are reachable from any page and
        not only from the filter bar on the homepage. Built from the section's category
        blocks; falls back to nothing if none are set.
      {%- endcomment -%}
      {%- assign cat_blocks = section.blocks | where: 'type', 'category' -%}
      {%- if cat_blocks.size > 0 -%}
        <div class="zk-cats">
          <button type="button" class="zk-cats__btn" aria-expanded="false" aria-controls="zkCatMenu">
            {%- render 'zk-t', override: section.settings.nav_cats, key: 'zk.nav_cats' -%}
            <svg viewBox="0 0 12 8" aria-hidden="true"><path d="M1 1l5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>
          </button>
          <div class="zk-cats__menu" id="zkCatMenu" hidden>
            {%- for block in cat_blocks -%}
              {%- assign c = block.settings.collection -%}
              {%- if c != blank -%}
                <a href="{{ c.url }}" data-cat="{{ c.handle }}" {{ block.shopify_attributes }}>
                  <span>{{ block.settings.label | default: c.title }}</span>
                  <i>{{ c.all_products_count }}</i>
                </a>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}

      {%- assign link_blocks = section.blocks | where: 'type', 'link' -%}
      {%- if link_blocks.size > 0 -%}
        {%- for block in link_blocks -%}
          <a href="{{ block.settings.link | default: '#' }}" {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
        {%- endfor -%}
      {%- else -%}
        <a href="{{ base }}#range">{% render 'zk-t', override: section.settings.nav_palinka, key: 'zk.nav_palinka' %}</a>
        <a href="{{ base }}#shop" class="nav-shop">{% render 'zk-t', override: section.settings.nav_shop, key: 'zk.nav_shop' %}</a>
        <a href="{{ base }}#story">{% render 'zk-t', override: section.settings.nav_story, key: 'zk.nav_story' %}</a>
        <a href="{{ base }}#taste">{% render 'zk-t', override: section.settings.nav_taste, key: 'zk.nav_taste' %}</a>
        <a href="{{ base }}#contact">{% render 'zk-t', override: section.settings.nav_contact, key: 'zk.nav_contact' %}</a>
      {%- endif -%}
    </nav>

    <div class="tools">
      {% render 'zk-social' %}
      {% render 'zk-lang' %}
      <a class="cartbtn" href="{{ routes.cart_url }}">
        <span>{% render 'zk-t', override: section.settings.cart_label, key: 'zk.cart' %}</span>
        <b id="cartCount">{{ cart.item_count }}</b>
      </a>
    </div>
  </div>
</header>
{%- comment -%}
  Mobile navigation panel. Mirrors the desktop nav and the category menu rather than
  inventing a second information architecture.
{%- endcomment -%}
<div class="zk-mnav" id="zkMobileNav" hidden>
  <div class="zk-mnav__inner">
    {%- if cat_blocks.size > 0 -%}
      <p class="zk-mnav__label">{{ 'zk.nav_cats' | t }}</p>
      <div class="zk-mnav__cats">
        {%- for block in cat_blocks -%}
          {%- assign c = block.settings.collection -%}
          {%- if c != blank -%}
            <a href="{{ c.url }}" data-cat="{{ c.handle }}">
              <span>{{ block.settings.label | default: c.title }}</span>
              <i>{{ c.all_products_count }}</i>
            </a>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    <p class="zk-mnav__label">{{ 'zk.nav_menu' | t }}</p>
    <div class="zk-mnav__links">
      <a href="{{ base }}#range">{% render 'zk-t', override: section.settings.nav_palinka, key: 'zk.nav_palinka' %}</a>
      <a href="{{ base }}#shop" class="nav-shop">{% render 'zk-t', override: section.settings.nav_shop, key: 'zk.nav_shop' %}</a>
      <a href="{{ base }}#story">{% render 'zk-t', override: section.settings.nav_story, key: 'zk.nav_story' %}</a>
      <a href="{{ base }}#taste">{% render 'zk-t', override: section.settings.nav_taste, key: 'zk.nav_taste' %}</a>
      <a href="{{ base }}#contact">{% render 'zk-t', override: section.settings.nav_contact, key: 'zk.nav_contact' %}</a>
    </div>

    <div class="zk-mnav__foot">
      {% render 'zk-lang' %}
      {% render 'zk-social' %}
    </div>
  </div>
</div>


<script>
  (function () {
    var wrap = document.querySelector('.zk-cats');
    if (!wrap) return;
    var btn = wrap.querySelector('.zk-cats__btn');
    var menu = wrap.querySelector('.zk-cats__menu');

    function close() { menu.hidden = true; btn.setAttribute('aria-expanded', 'false'); }
    function open() { menu.hidden = false; btn.setAttribute('aria-expanded', 'true'); }

    btn.addEventListener('click', function (e) {
      e.stopPropagation();
      menu.hidden ? open() : close();
    });
    document.addEventListener('click', function (e) { if (!wrap.contains(e.target)) close(); });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape') close(); });

    // On the homepage the categories filter the grid in place instead of navigating.
    if (document.getElementById('zkGrid')) {
      menu.querySelectorAll('a[data-cat]').forEach(function (a) {
        a.addEventListener('click', function (e) {
          e.preventDefault();
          close();
          var target = document.querySelector('#zkFilters button[data-f="' + a.getAttribute('data-cat') + '"]');
          if (target) { target.click(); document.getElementById('shop').scrollIntoView({ behavior: 'smooth' }); }
          else { window.location.href = a.href; }
        });
      });
    }

    // Which section am I in? Mark the matching nav link while scrolling the homepage,
    // and mark the current collection in the category menu on other pages.
    var navLinks = [].slice.call(document.querySelectorAll('nav.main a[href*="#"]'));
    var targets = navLinks
      .map(function (a) {
        var id = (a.getAttribute('href') || '').split('#')[1];
        return id ? { link: a, el: document.getElementById(id) } : null;
      })
      .filter(function (t) { return t && t.el; });

    if (targets.length && 'IntersectionObserver' in window) {
      var seen = {};
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) { seen[e.target.id] = e.intersectionRatio; });
        var best = null, bestRatio = 0;
        targets.forEach(function (t) {
          var r = seen[t.el.id] || 0;
          if (r > bestRatio) { bestRatio = r; best = t; }
        });
        navLinks.forEach(function (a) { a.classList.remove('on'); });
        if (best && bestRatio > 0.08) best.link.classList.add('on');
      }, { threshold: [0, .1, .25, .5, .75, 1], rootMargin: '-70px 0px -45% 0px' });
      targets.forEach(function (t) { io.observe(t.el); });
    }

    // On a collection page the category menu shows where you are.
    function trimSlash(p) { return p.length > 1 && p.charAt(p.length - 1) === '/' ? p.slice(0, -1) : p; }
    var here = trimSlash(location.pathname);
    document.querySelectorAll('.zk-cats__menu a[href]').forEach(function (a) {
      if (here && trimSlash(a.getAttribute('href')) === here) {
        a.classList.add('on');
        var btn = document.querySelector('.zk-cats__btn');
        if (btn) btn.classList.add('on');
      }
    });

    // Burger opens the panel; body scroll is locked while it is open.
    var burger = document.getElementById("zkBurger");
    var panel = document.getElementById("zkMobileNav");
    if (burger && panel) {
      var setOpen = function (open) {
        panel.hidden = !open;
        burger.setAttribute("aria-expanded", open ? "true" : "false");
        burger.classList.toggle("on", open);
        document.documentElement.style.overflow = open ? "hidden" : "";
      };
      burger.addEventListener("click", function () { setOpen(panel.hidden); });
      panel.addEventListener("click", function (e) {
        if (e.target.closest("a") || e.target === panel) setOpen(false);
      });
      document.addEventListener("keydown", function (e) { if (e.key === "Escape") setOpen(false); });
      window.addEventListener("resize", function () { if (window.innerWidth > 860) setOpen(false); });
    }

    // The header is server-rendered, and Shopify can serve that HTML from cache, so
    // {{ cart.item_count }} lags the real cart — it kept showing 0 after adding items.
    // Read the truth from the cart API, and add to the cart without leaving the page so
    // the number moves the moment the shopper clicks.
    var CART_URL = {{ routes.cart_url | json }};

    function paintCount(n) {
      document.querySelectorAll("#cartCount, .cartbtn b").forEach(function (el) { el.textContent = n; });
      document.querySelectorAll(".cartbtn").forEach(function (el) { el.classList.toggle("has", n > 0); });
    }

    fetch(CART_URL + ".js", { headers: { Accept: "application/json" } })
      .then(function (r) { return r.json(); })
      .then(function (c) { paintCount(c.item_count); })
      .catch(function () {});

    document.addEventListener("submit", function (e) {
      var form = e.target.closest('form[action*="/cart/add"]');
      if (!form) return;
      e.preventDefault();
      var btn = form.querySelector('[type="submit"]');
      var label = btn ? btn.textContent : "";
      if (btn) { btn.disabled = true; }
      fetch(CART_URL + "/add.js", { method: "POST", body: new FormData(form) })
        .then(function (r) { return r.json(); })
        .then(function () { return fetch(CART_URL + ".js", { headers: { Accept: "application/json" } }); })
        .then(function (r) { return r.json(); })
        .then(function (c) {
          paintCount(c.item_count);
          if (btn) { btn.textContent = "✓"; btn.classList.add("done"); }
          setTimeout(function () {
            if (btn) { btn.textContent = label; btn.classList.remove("done"); btn.disabled = false; }
          }, 1400);
        })
        .catch(function () { if (btn) { btn.disabled = false; form.submit(); } });
    });
  })();
</script>

{% schema %}
{
  "name": "Antet",
  "settings": [
    {
      "type": "paragraph",
      "content": "Fără elemente de meniu adăugate mai jos, antetul folosește navigarea implicită a paginii principale."
    },
    {
      "type": "text",
      "id": "nav_palinka",
      "label": "Meniu · Pălincile",
      "info": "Gol = textul tradus din locales/"
    },
    {
      "type": "text",
      "id": "nav_shop",
      "label": "Meniu · Magazin",
      "info": "Gol = textul tradus din locales/"
    },
    {
      "type": "text",
      "id": "nav_story",
      "label": "Meniu · Poveste",
      "info": "Gol = textul tradus din locales/"
    },
    {
      "type": "text",
      "id": "nav_taste",
      "label": "Meniu · Degustare",
      "info": "Gol = textul tradus din locales/"
    },
    {
      "type": "text",
      "id": "nav_contact",
      "label": "Meniu · Contact",
      "info": "Gol = textul tradus din locales/"
    },
    {
      "type": "text",
      "id": "cart_label",
      "label": "Etichetă coș",
      "info": "Gol = textul tradus din locales/"
    },
    {
      "type": "text",
      "id": "nav_cats",
      "label": "Meniu · Categorii",
      "info": "Gol = textul tradus din locales/"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Categorie",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Colecție"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Etichetă",
          "info": "Gol = numele colecției"
        }
      ]
    },
    {
      "type": "link",
      "name": "Element de meniu",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Text",
          "default": "Meniu"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ]
}
{% endschema %}
