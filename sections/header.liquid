<header class="site-header {% if section.settings.sticky %}site-header--sticky{% endif %}" id="site-header">
  <div class="header-inner">
    <a href="/" class="header-logo">
      {% if section.settings.logo != blank %}
        <img src="{{ section.settings.logo | img_url: '200x' }}" alt="{{ shop.name }}" class="header-logo__img">
      {% else %}
        <span class="header-logo__text">{{ section.settings.logo_text | default: shop.name }}</span>
      {% endif %}
    </a>

    <nav class="header-nav" id="header-nav">
      <ul class="header-nav__list">
        {% for link in linklists[section.settings.menu].links %}
        <li class="header-nav__item">
          <a href="{{ link.url }}" class="header-nav__link {% if link.active %}active{% endif %}">
            {{ link.title }}
          </a>
        </li>
        {% endfor %}
      </ul>
    </nav>

    <div class="header-actions">
      {% if section.settings.show_search %}
      <a href="/search" class="header-action" aria-label="{{ section.settings.search_label | default: 'Căutare' }}">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
      </a>
      {% endif %}
      <a href="/cart" class="header-action header-cart" aria-label="{{ section.settings.cart_label | default: 'Coș' }}">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 01-8 0"/></svg>
        <span class="header-cart__count" id="cart-count">{{ cart.item_count }}</span>
      </a>
      {% if section.settings.cta_text != blank %}
      <a href="{{ section.settings.cta_url | default: '/collections/all' }}" class="header-cta">
        {{ section.settings.cta_text }}
      </a>
      {% endif %}
    </div>

    <button class="header-burger" id="header-burger" aria-label="Meniu">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "header", "content": "Logo" },
    { "type": "image_picker", "id": "logo", "label": "Logo imagine" },
    { "type": "text", "id": "logo_text", "label": "Text logo (dacă nu există imagine)", "default": "ZEKULHYDA" },
    { "type": "header", "content": "Navigare" },
    { "type": "link_list", "id": "menu", "label": "Meniu principal", "default": "main-menu" },
    { "type": "checkbox", "id": "sticky", "label": "Header fix (sticky)", "default": true },
    { "type": "header", "content": "Acțiuni" },
    { "type": "checkbox", "id": "show_search", "label": "Afișează buton căutare", "default": true },
    { "type": "text", "id": "cart_label", "label": "Etichetă coș", "default": "Coș" },
    { "type": "text", "id": "search_label", "label": "Etichetă căutare", "default": "Căutare" },
    { "type": "text", "id": "cta_text", "label": "Text buton CTA", "default": "Comandă Acum" },
    { "type": "url", "id": "cta_url", "label": "Link buton CTA" }
  ]
}
{% endschema %}
