{%- liquid
  assign home = routes.root_url
  if template.name == 'index'
    assign base = ''
  else
    assign base = home
  endif
-%}

<header class="top">
  <div class="wrap">
    <a class="brand" href="{{ home }}" aria-label="{{ shop.name }}">{% render 'zk-logo' %}</a>

    <nav class="main">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          <a href="{{ block.settings.link | default: '#' }}" {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
        {%- endfor -%}
      {%- else -%}
        <a href="{{ base }}#range">{{ section.settings.nav_palinka | default: 'Pălincile' }}</a>
        <a href="{{ base }}#shop">{{ section.settings.nav_shop | default: 'Magazin' }}</a>
        <a href="{{ base }}#story">{{ section.settings.nav_story | default: 'Povestea lui Botond' }}</a>
        <a href="{{ base }}#taste">{{ section.settings.nav_taste | default: 'Sala de degustare' }}</a>
        <a href="{{ base }}#contact">{{ section.settings.nav_contact | default: 'Contact' }}</a>
      {%- endif -%}
    </nav>

    <div class="tools">
      {% render 'zk-social' %}
      <a class="cartbtn" href="{{ routes.cart_url }}">
        <span>{{ section.settings.cart_label | default: 'Coș' }}</span>
        <b id="cartCount">{{ cart.item_count }}</b>
      </a>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Antet",
  "settings": [
    { "type": "paragraph", "content": "Fără elemente de meniu adăugate mai jos, antetul folosește navigarea implicită a paginii principale." },
    { "type": "text", "id": "nav_palinka", "label": "Meniu · Pălincile", "default": "Pălincile" },
    { "type": "text", "id": "nav_shop", "label": "Meniu · Magazin", "default": "Magazin" },
    { "type": "text", "id": "nav_story", "label": "Meniu · Poveste", "default": "Povestea lui Botond" },
    { "type": "text", "id": "nav_taste", "label": "Meniu · Degustare", "default": "Sala de degustare" },
    { "type": "text", "id": "nav_contact", "label": "Meniu · Contact", "default": "Contact" },
    { "type": "text", "id": "cart_label", "label": "Etichetă coș", "default": "Coș" }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Element de meniu",
      "settings": [
        { "type": "text", "id": "label", "label": "Text", "default": "Meniu" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ]
}
{% endschema %}
