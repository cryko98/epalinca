{%- liquid
  assign head_eyebrow = 'zk.blog_eyebrow' | t
-%}
{% render 'zk-page-head', eyebrow: head_eyebrow, title: blog.title %}

<div class="blog-page">

  <div class="section-inner" style="padding-top:80px;padding-bottom:120px;">
    {% paginate blog.articles by 12 %}

    <div class="blog-grid">
      {% for article in blog.articles %}
        <article class="blog-card reveal delay-{{ forloop.index | modulo: 3 | plus: 1 }}">
          {% if article.image %}
            <a href="{{ article.url }}" class="blog-card__img-wrap">
              <img src="{{ article.image | image_url: width:800 }}" alt="{{ article.title }}" loading="lazy">
            </a>
          {% endif %}
          <div class="blog-card__body">
            <p class="blog-card__date">{{ article.published_at | date: '%d %B %Y' }}</p>
            <h3 class="blog-card__title"><a href="{{ article.url }}">{{ article.title }}</a></h3>
            <p class="blog-card__excerpt">{{ article.excerpt | strip_html | truncate: 140 }}</p>
            <a href="{{ article.url }}" class="blog-card__link">Citește mai mult →</a>
          </div>
        </article>
      {% else %}
        <p style="color:var(--color-cream-dim);font-family:var(--font-serif);font-style:italic;">
          Nu există articole publicate încă.
        </p>
      {% endfor %}
    </div>

    {% if paginate.pages > 1 %}
      <div class="pagination" style="margin-top:60px;text-align:center;">
        {{ paginate | default_pagination }}
      </div>
    {% endif %}

    {% endpaginate %}
  </div>
</div>

<style>
.blog-page__hero { padding:80px 0 40px; border-bottom:1px solid rgba(240,234,216,.06); }
.blog-page__title { font-family:var(--font-display); font-size:clamp(40px,4vw,64px); font-weight:400; color:var(--color-cream); margin-top:14px; }
</style>

{% schema %}
{
  "name": "Main Blog",
  "settings": []
}
{% endschema %}
