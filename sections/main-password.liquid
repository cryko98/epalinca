<h1 class="pw__title">{{ section.settings.title | default: 'În curând' }}</h1>
<p class="pw__text">
  {{ section.settings.text | default: 'Pivnița se pregătește. Reveniți în curând.' }}
</p>

{% form 'storefront_password' %}
  {%- if form.errors %}
    <p class="pw__errors">{{ form.errors.translated_fields.form }} {{ form.errors.messages.form }}</p>
  {%- endif %}
  <div class="pw__form">
    <label for="StorefrontPassword" class="visually-hidden">Parolă</label>
    <input type="password" name="password" id="StorefrontPassword" placeholder="Parolă" autocomplete="current-password">
    <button type="submit">Intră</button>
  </div>
{% endform %}

{% schema %}
{
  "name": "Pagina parola",
  "settings": [
    { "type": "text", "id": "title", "label": "Titlu", "default": "În curând" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Pivnița se pregătește. Reveniți în curând." }
  ]
}
{% endschema %}
