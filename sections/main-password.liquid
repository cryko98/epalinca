<h1 class="pw__title">{% render 'zk-t', override: section.settings.title, key: 'zk.pw_title' %}</h1>
<p class="pw__text">
  {% render 'zk-t', override: section.settings.text, key: 'zk.pw_text' %}
</p>

{% form 'storefront_password' %}
  {%- if form.errors %}
    <p class="pw__errors">{{ form.errors.translated_fields.form }} {{ form.errors.messages.form }}</p>
  {%- endif %}
  <div class="pw__form">
    <label for="StorefrontPassword" class="visually-hidden">{{ 'zk.pw_password' | t }}</label>
    <input type="password" name="password" id="StorefrontPassword" placeholder="{{ 'zk.pw_password' | t }}" autocomplete="current-password">
    <button type="submit">{{ 'zk.pw_enter' | t }}</button>
  </div>
{% endform %}

{% schema %}
{
  "name": "Pagina parola",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Titlu",
      "info": "Gol = textul tradus din locales/"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "info": "Gol = textul tradus din locales/"
    }
  ]
}
{% endschema %}
