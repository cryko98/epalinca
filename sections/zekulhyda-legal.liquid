{%- liquid
  assign company = section.settings.company_name
  assign cui = section.settings.cui
  assign regcom = section.settings.reg_com
  assign address = section.settings.address
  assign email = section.settings.email
  assign phone = section.settings.phone
  assign updated = section.settings.updated
-%}

<section class="zk-legal" id="zk-legal">
  <div class="zk-legal__inner">
    {%- case section.settings.doc -%}

    {%- when 'termeni' -%}
      {%- comment -%}
        The terms exist in all three storefront languages; the Romanian text is the
        binding one and the translations say so at the top.
      {%- endcomment -%}
      {%- liquid
        case request.locale.iso_code
          when 'hu'
            assign updated_l = section.settings.updated_hu | default: updated
            render 'zk-legal-termeni-hu', company: company, cui: cui, regcom: regcom, address: address, email: email, phone: phone, updated: updated_l
          when 'en'
            assign updated_l = section.settings.updated_en | default: updated
            render 'zk-legal-termeni-en', company: company, cui: cui, regcom: regcom, address: address, email: email, phone: phone, updated: updated_l
          else
            render 'zk-legal-termeni-ro', company: company, cui: cui, regcom: regcom, address: address, email: email, phone: phone, updated: updated
        endcase
      -%}

    {%- when 'confidentialitate', 'cookies', 'retur', 'livrare' -%}
      {%- comment -%}
        Privacy, cookies, returns, delivery & payment — one snippet per language, each holding
        the four documents. Romanian is the binding text; HU/EN carry a note saying so.
      {%- endcomment -%}
      {%- liquid
        assign doc = section.settings.doc
        assign ship_days = section.settings.ship_days | default: '1–3 zile lucrătoare'
        assign ship_cost = section.settings.ship_cost | default: '20 lei / comandă, în toată România'
        assign cod = section.settings.cod | default: true
        assign cod = cod | append: ''
        case request.locale.iso_code
          when 'hu'
            assign updated_l = section.settings.updated_hu | default: updated
            assign ship_days = section.settings.ship_days_hu | default: '1–3 munkanap'
            assign ship_cost = section.settings.ship_cost_hu | default: '20 lej / rendelés, egész Romániában'
            render 'zk-legal-docs-hu', doc: doc, company: company, cui: cui, regcom: regcom, address: address, email: email, phone: phone, updated: updated_l, ship_days: ship_days, ship_cost: ship_cost, cod: cod
          when 'en'
            assign updated_l = section.settings.updated_en | default: updated
            assign ship_days = section.settings.ship_days_en | default: '1–3 working days'
            assign ship_cost = section.settings.ship_cost_en | default: '20 lei per order, anywhere in Romania'
            render 'zk-legal-docs-en', doc: doc, company: company, cui: cui, regcom: regcom, address: address, email: email, phone: phone, updated: updated_l, ship_days: ship_days, ship_cost: ship_cost, cod: cod
          else
            render 'zk-legal-docs-ro', doc: doc, company: company, cui: cui, regcom: regcom, address: address, email: email, phone: phone, updated: updated, ship_days: ship_days, ship_cost: ship_cost, cod: cod
        endcase
      -%}

    {%- else -%}
      <h1 class="zk-legal__title">{{ page.title | default: 'Informații legale' }}</h1>
      <div class="zk-legal__rte rte">{{ page.content }}</div>

    {%- endcase -%}

  </div>
</section>

<script>
  (function () {
    // Build the two-column layout: everything after the head goes into a body column,
    // with a sticky contents rail listing the chapters. Works for every legal document.
    var inner = document.querySelector('#zk-legal .zk-legal__inner');
    if (!inner) return;
    var kids = [].slice.call(inner.children);
    var head = inner.querySelector('.zk-legal__head');
    if (!head) {
      head = document.createElement('div'); head.className = 'zk-legal__head';
      kids.forEach(function (k) {
        if (k.matches('.zk-legal__eyebrow, .zk-legal__title, .zk-legal__updated, .zk-legal__note')) head.appendChild(k);
      });
      inner.insertBefore(head, inner.firstChild);
      kids = [].slice.call(inner.children);
    }
    var layout = document.createElement('div'); layout.className = 'zk-legal__layout';
    var toc = document.createElement('nav'); toc.className = 'zk-legal__toc'; toc.setAttribute('aria-label', 'Cuprins');
    var body = document.createElement('div'); body.className = 'zk-legal__body';
    kids.forEach(function (k) { if (k !== head) body.appendChild(k); });
    var h2s = [].slice.call(body.querySelectorAll('h2'));
    if (h2s.length > 1) {
      var ol = document.createElement('ol');
      h2s.forEach(function (h, i) {
        if (!h.id) h.id = 's' + (i + 1);
        var num = h.querySelector('span') ? h.querySelector('span').textContent : String(i + 1).padStart(2, '0');
        var text = h.textContent.replace(num, '').replace(/^\s*\d+\.\s*/, '').trim();
        var li = document.createElement('li');
        li.innerHTML = '<a href="#' + h.id + '"><span>' + num + '</span>' + text + '</a>';
        ol.appendChild(li);
      });
      var label = document.createElement('p'); label.className = 'zk-legal__toc-label'; label.textContent = {{ 'zk.legal_contents' | t | json }};
      toc.appendChild(label); toc.appendChild(ol);
      layout.appendChild(toc);
    }
    layout.appendChild(body);
    inner.appendChild(layout);

    // Scroll-spy: mark the chapter in view.
    var links = [].slice.call(toc.querySelectorAll('a'));
    if (links.length && 'IntersectionObserver' in window) {
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (!e.isIntersecting) return;
          links.forEach(function (a) { a.classList.toggle('on', a.getAttribute('href') === '#' + e.target.id); });
        });
      }, { rootMargin: '-100px 0px -70% 0px' });
      h2s.forEach(function (h) { io.observe(h); });
    }
  })();
</script>

{% schema %}
{
  "name": "Zekulhyda - Legal",
  "tag": "section",
  "settings": [
    {
      "type": "select",
      "id": "doc",
      "label": "Document",
      "options": [
        {
          "value": "termeni",
          "label": "Termeni și condiții"
        },
        {
          "value": "confidentialitate",
          "label": "Politica de confidențialitate"
        },
        {
          "value": "cookies",
          "label": "Politica de cookie-uri"
        },
        {
          "value": "retur",
          "label": "Politica de retur"
        },
        {
          "value": "livrare",
          "label": "Livrare și plată"
        },
        {
          "value": "page",
          "label": "Conținut pagină (page.content)"
        }
      ],
      "default": "termeni"
    },
    {
      "type": "header",
      "content": "Date firmă (completați)"
