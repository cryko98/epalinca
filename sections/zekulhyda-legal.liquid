      "id": "company_name",
      "label": "Denumire firmă",
      "default": "GRĂDINA VERDE S.R.L."
    },
    {
      "type": "text",
      "id": "cui",
      "label": "CUI / CIF",
      "default": "RO15476755"
    },
    {
      "type": "text",
      "id": "reg_com",
      "label": "Nr. Reg. Comerțului",
      "default": "J05/672/2003"
    },
    {
      "type": "text",
      "id": "address",
      "label": "Sediu social",
      "default": "Str. Morii 24, Săcueni, jud. Bihor, 417435"
    },
    {
      "type": "text",
      "id": "email",
      "label": "E-mail contact",
      "default": "office@epalinca.ro"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Telefon",
      "default": "0742 908 047"
    },
    {
      "type": "text",
      "id": "updated",
      "label": "Data ultimei actualizări",
      "default": "septembrie 2026"
    },
    {
      "type": "text",
      "id": "updated_hu",
      "label": "Data actualizării (HU)",
      "default": "2026. szeptember"
    },
    {
      "type": "header",
      "content": "Livrare și plată"
    },
    {
      "type": "text",
      "id": "ship_days",
      "label": "Termen de livrare (RO)",
      "default": "1–3 zile lucrătoare"
    },
    {
      "type": "text",
      "id": "ship_days_hu",
      "label": "Termen de livrare (HU)",
      "default": "1–3 munkanap"
    },
    {
      "type": "text",
      "id": "ship_days_en",
      "label": "Termen de livrare (EN)",
      "default": "1–3 working days"
    },
    {
      "type": "text",
      "id": "ship_cost",
      "label": "Cost livrare (RO)",
      "default": "20 lei / comandă, în toată România",
      "info": "Trebuie să corespundă tarifului configurat în Shopify › Setări › Livrare."
    },
    {
      "type": "text",
      "id": "ship_cost_hu",
      "label": "Cost livrare (HU)",
      "default": "20 lej / rendelés, egész Romániában"
    },
    {
      "type": "text",
      "id": "ship_cost_en",
      "label": "Cost livrare (EN)",
      "default": "20 lei per order, anywhere in Romania"
    },
    {
      "type": "checkbox",
      "id": "cod",
      "label": "Plata ramburs este disponibilă",
      "default": true
    },
    {
      "type": "text",
      "id": "updated_en",
      "label": "Data actualizării (EN)",
      "default": "September 2026"
    }
  ],
  "presets": [
    {
      "name": "Zekulhyda - Legal"
    }
  ]
}
{% endschema %}
