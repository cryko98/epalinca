<div class="search-page" style="padding-top:80px;">

  <div class="search-page__hero">
    <div class="section-inner">
      <div class="section-label">
        <span class="section-label-line"></span>
        <span class="section-label-text">{{ 'general.search' | t }}</span>
      </div>
      <h1 class="search-page__title">
        {%- if search.performed -%}
          {{ search.results_count }}
          {%- if search.results_count == 1 %} rezultat{% else %} rezultate{% endif -%}
        {%- else -%}
          Căutare
        {%- endif -%}
      </h1>
      {%- if search.performed and search.terms != blank %}
        <p class="search-page__terms">pentru „{{ search.terms | escape }}”</p>
      {%- endif %}

      <form action="{{ routes.search_url }}" method="get" role="search" class="search-page__form">
        <input type="hidden" name="options[prefix]" value="last">
        <label for="SearchInput" class="visually-hidden">{{ 'general.search' | t }}</label>
        <input type="search" name="q" id="SearchInput" value="{{ search.terms | escape }}"
               placeholder="Caută pălincă, soi, an…" class="search-page__input">
        <button type="submit" class="search-page__submit">{{ 'general.search' | t }}</button>
      </form>
    </div>
  </div>

  <div class="section-inner search-page__body">

    {%- if search.performed -%}
      {%- if search.results_count > 0 -%}

        {% paginate search.results by 24 %}
          <div class="product-grid product-grid--3">
            {%- for item in search.results -%}

              {%- if item.object_type == 'product' -%}
                <div class="product-card product-card--dark">
                  <a href="{{ item.url }}" class="product-card__image-wrap">
                    <div class="product-card__glow"></div>
                    {%- if item.featured_image -%}
                      <img src="{{ item.featured_image | image_url: width: 600 }}"
                           alt="{{ item.title | escape }}"
                           width="{{ item.featured_image.width }}" height="{{ item.featured_image.height }}"
                           class="product-card__img" loading="lazy">
                    {%- else -%}
                      {% render 'bottle-svg', color: 'premium' %}
                    {%- endif -%}
                  </a>
                  <div class="product-card__info">
                    <p class="product-card__origin">{{ item.vendor }}</p>
                    <h3 class="product-card__name"><a href="{{ item.url }}">{{ item.title }}</a></h3>
                    <div class="product-card__foot">
                      <div class="product-card__price">
                        <sub>{{ cart.currency.symbol }}</sub>{{ item.price | money_without_currency }}
                      </div>
                    </div>
                  </div>
                </div>

              {%- else -%}
                <div class="search-card">
                  <p class="search-card__type">
                    {%- case item.object_type -%}
                      {%- when 'article' -%}Articol
                      {%- when 'page' -%}Pagină
                      {%- else -%}{{ item.object_type }}
                    {%- endcase -%}
                  </p>
                  <h3 class="search-card__title"><a href="{{ item.url }}">{{ item.title }}</a></h3>
                  {%- if item.content != blank %}
                    <p class="search-card__excerpt">{{ item.content | strip_html | truncate: 140 }}</p>
                  {%- endif %}
                  <a href="{{ item.url }}" class="search-card__link">Deschide →</a>
                </div>
              {%- endif -%}

            {%- endfor -%}
          </div>

          {%- if paginate.pages > 1 %}
            <div class="pagination" style="margin-top:60px;text-align:center;">
              {{ paginate | default_pagination }}
            </div>
          {%- endif %}
        {% endpaginate %}

      {%- else -%}
        <p class="search-page__empty">
          Nu am găsit nimic pentru „{{ search.terms | escape }}”. Încercați alt termen.
        </p>
      {%- endif -%}

    {%- else -%}
      <p class="search-page__empty">Introduceți un termen de căutare.</p>
    {%- endif -%}

  </div>
</div>

<style>
.search-page__hero { padding:80px 0 40px; border-bottom:1px solid rgba(240,234,216,.06); }
.search-page__title { font-family:var(--font-display); font-size:clamp(36px,4vw,58px); font-weight:400; color:var(--color-cream); margin-top:14px; }
.search-page__terms { font-family:var(--font-serif); font-style:italic; font-size:17px; color:var(--color-cream-dim); margin-top:8px; }
.search-page__form { display:flex; max-width:520px; margin-top:28px; border:1px solid var(--color-line); border-radius:2px; overflow:hidden; }
.search-page__input { flex:1; background:transparent; border:0; padding:14px 16px; color:var(--color-cream); font-family:var(--font-body); font-size:14px; }
.search-page__input::placeholder { color:var(--color-fog); }
.search-page__input:focus { outline:none; }
.search-page__submit { background:var(--color-gold); border:0; color:var(--color-ink); padding:0 24px; font-family:var(--font-body); font-size:13px; letter-spacing:.06em; text-transform:uppercase; cursor:pointer; }
.search-page__submit:hover { background:var(--color-gold-hi); }
.search-page__body { padding:64px 0 120px; }
.search-page__empty { font-family:var(--font-serif); font-style:italic; font-size:17px; color:var(--color-cream-dim); }
.search-card { border:1px solid var(--color-line); padding:28px; background:var(--color-graphite); }
.search-card__type { font-family:var(--font-mono); font-size:11px; letter-spacing:.12em; text-transform:uppercase; color:var(--color-gold); }
.search-card__title { font-family:var(--font-display); font-size:24px; font-weight:400; color:var(--color-cream); margin:10px 0 12px; }
.search-card__title a:hover { color:var(--color-gold); }
.search-card__excerpt { font-family:var(--font-serif); font-style:italic; font-size:15px; line-height:1.85; color:var(--color-cream-dim); }
.search-card__link { display:inline-block; margin-top:16px; font-family:var(--font-mono); font-size:12px; letter-spacing:.08em; color:var(--color-gold); }
.visually-hidden { position:absolute; width:1px; height:1px; overflow:hidden; clip:rect(0 0 0 0); white-space:nowrap; }
</style>

{% schema %}
{
  "name": "Main Cautare",
  "settings": []
}
{% endschema %}
