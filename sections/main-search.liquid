{%- liquid
  assign head_eyebrow = 'general.search' | t
  assign head_title = 'zk.search_title' | t

  if search.performed
    if search.results_count == 1
      assign word = 'zk.search_one' | t
    else
      assign word = 'zk.search_many' | t
    endif
    assign for_terms = 'zk.search_for' | t: terms: search.terms
    assign head_meta = search.results_count | append: ' ' | append: word | append: ' ' | append: for_terms
  endif
-%}

{% render 'zk-page-head', eyebrow: head_eyebrow, title: head_title, meta: head_meta %}

<section class="zk-shop">
  <div class="wrap">

    <form action="{{ routes.search_url }}" method="get" role="search" class="zk-search">
      <input type="hidden" name="options[prefix]" value="last">
      <label for="SearchInput" class="visually-hidden">{{ 'general.search' | t }}</label>
      <input type="search" name="q" id="SearchInput" value="{{ search.terms | escape }}"
             placeholder="{{ 'zk.search_placeholder' | t }}">
      <button type="submit">{{ 'general.search' | t }}</button>
    </form>

    {%- if search.performed -%}
      {%- if search.results_count > 0 -%}
        {% paginate search.results by 24 %}
          <div class="grid">
            {%- for item in search.results -%}
              {%- if item.object_type == 'product' -%}
                {% render 'zk-product-card', product: item %}
              {%- else -%}
                <div class="zk-result">
                  <span class="zk-result__type">
                    {%- case item.object_type -%}
                      {%- when 'article' -%}{{ 'zk.search_type_article' | t }}
                      {%- when 'page' -%}{{ 'zk.search_type_page' | t }}
                      {%- else -%}{{ item.object_type }}
                    {%- endcase -%}
                  </span>
                  <h3><a href="{{ item.url }}">{{ item.title }}</a></h3>
                  {%- if item.content != blank -%}
                    <p>{{ item.content | strip_html | truncate: 140 }}</p>
                  {%- endif -%}
                  <a href="{{ item.url }}" class="zk-result__link">{{ 'zk.search_open' | t }} →</a>
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>

          {%- if paginate.pages > 1 -%}
            <div class="zk-pager">{{ paginate | default_pagination }}</div>
          {%- endif -%}
        {% endpaginate %}
      {%- else -%}
        <p class="zk-empty">{{ 'zk.search_empty' | t: terms: search.terms }}</p>
      {%- endif -%}
    {%- else -%}
      <p class="zk-empty">{{ 'zk.search_prompt' | t }}</p>
    {%- endif -%}

  </div>
</section>

{% schema %}
{
  "name": "Main Căutare",
  "settings": []
}
{% endschema %}
