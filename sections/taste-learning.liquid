<section id="taste" class="band" style="background-image:url({{ 'zk-20.jpg' | asset_url }})">
  <div class="wrap">

    <div class="intro">
      <div class="reveal">
        <div class="eyebrow">{% render 'zk-t', override: section.settings.taste_eyebrow, key: 'zk.taste_eyebrow' %}</div>
        <h2 style="margin:.6rem 0 1rem">{% render 'zk-t', override: section.settings.taste_title, key: 'zk.taste_title' %}</h2>
        <p style="color:var(--silver)">{% render 'zk-t', override: section.settings.taste_p, key: 'zk.taste_p' %}</p>
        <ul>
          <li>{% render 'zk-t', override: section.settings.taste_1, key: 'zk.taste_1' %}</li>
          <li>{% render 'zk-t', override: section.settings.taste_2, key: 'zk.taste_2' %}</li>
          <li>{% render 'zk-t', override: section.settings.taste_3, key: 'zk.taste_3' %}</li>
        </ul>
      </div>
      <div>
        <img src="{{ 'zk-19.jpg' | asset_url }}" alt="Nagy Botond degustând" style="width:100%;border-radius:4px;aspect-ratio:4/3;object-fit:cover">
      </div>
    </div>

    <div class="gallery reveal">
      <img src="{{ 'zk-21.jpg' | asset_url }}" alt="Sala de degustare Zekulhyda">
      <img src="{{ 'zk-22.jpg' | asset_url }}" alt="Peretele pictat al sălii de degustare">
      <img src="{{ 'zk-23.jpg' | asset_url }}" alt="Sticlă pe tejgheaua de degustare">
    </div>

    <div class="sec-head reveal">
      <div class="eyebrow">{% render 'zk-t', override: section.settings.pk_eyebrow, key: 'zk.pk_eyebrow' %}</div>
      <h2>{% render 'zk-t', override: section.settings.pk_title, key: 'zk.pk_title' %}</h2>
      <p style="color:var(--fog)">{% render 'zk-t', override: section.settings.pk_sub, key: 'zk.pk_sub' %}</p>
    </div>

    <div class="packs">
      {%- for block in section.blocks -%}
        {%- if block.type == 'pack' -%}
          <div class="pack reveal{% if block.settings.highlight %} hi sel{% endif %}" data-pack="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
            {%- if block.settings.tag != blank %}<span class="tag">{{ block.settings.tag }}</span>{% endif %}
            <h3>{{ block.settings.name }}</h3>
            <div class="meta"><span>{{ block.settings.time }}</span><span>{{ block.settings.people }}</span></div>
            <div class="prices">
              <div><b>{{ block.settings.price_weekday }}<small>lei</small></b><span>{{ 'zk.pk_weekday' | t }}</span></div>
              <div><b>{{ block.settings.price_weekend }}<small>lei</small></b><span>{{ 'zk.pk_weekend' | t }}</span></div>
            </div>
            <div class="incl">{{ 'zk.pk_incl' | t }}</div>
            <ul>
              {%- for i in (1..4) -%}
                {%- assign key = 'item_' | append: i -%}
                {%- assign val = block.settings[key] -%}
                {%- if val != blank %}<li>{{ val }}</li>{% endif -%}
              {%- endfor -%}
            </ul>
            <a class="btn{% if block.settings.highlight %} primary{% endif %}" href="#booking">{{ 'zk.pk_book' | t }}</a>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <div class="addons reveal">
      <div><span>{{ 'zk.pk_add1' | t }}</span><b>15 lei</b></div>
      <div><span>{{ 'zk.pk_add2' | t }}</span><b>45 lei</b></div>
      <div><span>{{ 'zk.pk_add3' | t }}</span><b>{{ 'zk.pk_add3_v' | t }}</b></div>
      <div><span>{{ 'zk.pk_add4' | t }}</span><b>{{ 'zk.pk_add4_v' | t }}</b></div>
    </div>

    <p class="pk-note">{% render 'zk-t', override: section.settings.pk_note, key: 'zk.pk_note' %}</p>

    <div class="booking reveal" id="booking">
      <div>
        <div class="eyebrow">{{ 'zk.bk_title' | t }}</div>
        <h3 style="margin-top:.6rem">{% render 'zk-t', override: section.settings.taste_cta, key: 'zk.taste_cta' %}</h3>
        <p style="color:var(--fog);font-size:.9rem">{% render 'zk-t', override: section.settings.contact_hours, key: 'zk.contact_hours' %}</p>
        <p>
          <a href="tel:+40742908047" style="color:var(--amber-2);text-decoration:none">+40 742 908 047</a><br>
          <a href="mailto:office@epalinca.ro" style="color:var(--amber-2);text-decoration:none">office@epalinca.ro</a>
        </p>
      </div>

      {%- comment -%}
        In the reference this form was a demo that never submitted. Here it is a real
        Shopify contact form. Each field keeps the prototype's `id` so the live price
        estimator in zekulhyda.js still finds it, while `name="contact[...]"` is what
        actually gets emailed to the shop.
      {%- endcomment -%}
      {% form 'contact', id: 'bkForm' %}
        {%- if form.posted_successfully? %}
          <p class="demo" style="color:var(--amber-2)">Mulțumim! Am primit cererea, revenim cu confirmarea.</p>
        {%- endif %}
        {%- if form.errors %}
          <p class="demo" style="color:#e8a1a1">{{ form.errors.translated_fields.email | default: 'Verificați câmpurile' }} — {{ form.errors.messages.email }}</p>
        {%- endif %}

        <label><span>{{ 'zk.bk_date' | t }}</span><input type="date" required id="date" name="contact[Data]"></label>
        <label><span>{{ 'zk.bk_ppl' | t }}</span><input type="number" min="6" max="40" value="8" required id="ppl" name="contact[Persoane]"></label>
        <label><span>{{ 'zk.bk_pack' | t }}</span>
          <select id="bkPack" name="contact[Pachet]">
            {%- for block in section.blocks -%}
              {%- if block.type == 'pack' -%}
                <option{% if block.settings.highlight %} selected{% endif %}>{{ block.settings.name }}</option>
              {%- endif -%}
            {%- endfor -%}
          </select>
        </label>
        <label><span>{{ 'zk.bk_food' | t }}</span>
          <select id="food" name="contact[Mancare]">
            <option>{{ 'zk.bk_food_none' | t }}</option>
            <option>{{ 'zk.bk_food_cold' | t }}</option>
          </select>
        </label>
        <label><span>{{ 'zk.bk_name' | t }}</span><input required name="contact[Nume]"></label>
        <label><span>{{ 'zk.bk_phone' | t }}</span><input required type="email" name="contact[email]"></label>

        <div class="estimate" id="estimate"></div>
        <button class="btn primary full" type="submit">{{ 'zk.bk_submit' | t }}</button>
        <span class="demo">Prețul afișat este orientativ; confirmarea finală vine pe e-mail.</span>
      {% endform %}
    </div>

  </div>
</section>

