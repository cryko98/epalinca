          "label": "Include 1",
          "info": "Gol = textul tradus din locales/"
        },
        {
          "type": "text",
          "id": "item_2",
          "label": "Include 2",
          "info": "Gol = textul tradus din locales/"
        },
        {
          "type": "text",
          "id": "item_3",
          "label": "Include 3",
          "info": "Gol = textul tradus din locales/"
        },
        {
          "type": "text",
          "id": "item_4",
          "label": "Include 4",
          "info": "Gol = textul tradus din locales/"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Degustare & pachete",
      "blocks": [
        {
          "type": "pack",
          "settings": {
            "tkey": "pk1",
            "price_weekday": 90,
            "price_weekend": 110
          }
