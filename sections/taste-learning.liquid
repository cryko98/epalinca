<section id="taste" class="band" style="background-image:url({{ 'zk-20.jpg' | asset_url }})">
  <div class="wrap">

    <div class="intro">
      <div class="reveal">
        <div class="eyebrow">{{ section.settings.taste_eyebrow }}</div>
        <h2 style="margin:.6rem 0 1rem">{{ section.settings.taste_title }}</h2>
        <p style="color:var(--silver)">{{ section.settings.taste_p }}</p>
        <ul>
          <li>{{ section.settings.taste_1 }}</li>
          <li>{{ section.settings.taste_2 }}</li>
          <li>{{ section.settings.taste_3 }}</li>
        </ul>
      </div>
      <div>
        <img src="{{ 'zk-19.jpg' | asset_url }}" alt="Nagy Botond degustând" style="width:100%;border-radius:4px;aspect-ratio:4/3;object-fit:cover">
      </div>
    </div>

    <div class="gallery reveal">
      <img src="{{ 'zk-21.jpg' | asset_url }}" alt="Sala de degustare Zekulhyda">
      <img src="{{ 'zk-22.jpg' | asset_url }}" alt="Peretele pictat al sălii de degustare">
      <img src="{{ 'zk-23.jpg' | asset_url }}" alt="Sticlă pe tejgheaua de degustare">
    </div>

    <div class="sec-head reveal">
      <div class="eyebrow">{{ section.settings.pk_eyebrow }}</div>
      <h2>{{ section.settings.pk_title }}</h2>
      <p style="color:var(--fog)">{{ section.settings.pk_sub }}</p>
    </div>

    <div class="packs">
      {%- for block in section.blocks -%}
        {%- if block.type == 'pack' -%}
          <div class="pack reveal{% if block.settings.highlight %} hi sel{% endif %}" data-pack="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
            {%- if block.settings.tag != blank %}<span class="tag">{{ block.settings.tag }}</span>{% endif %}
            <h3>{{ block.settings.name }}</h3>
            <div class="meta"><span>{{ block.settings.time }}</span><span>{{ block.settings.people }}</span></div>
            <div class="prices">
              <div><b>{{ block.settings.price_weekday }}<small>lei</small></b><span>în timpul săptămânii</span></div>
              <div><b>{{ block.settings.price_weekend }}<small>lei</small></b><span>weekend</span></div>
            </div>
            <div class="incl">Include</div>
            <ul>
              {%- for i in (1..4) -%}
                {%- assign key = 'item_' | append: i -%}
                {%- assign val = block.settings[key] -%}
                {%- if val != blank %}<li>{{ val }}</li>{% endif -%}
              {%- endfor -%}
            </ul>
            <a class="btn{% if block.settings.highlight %} primary{% endif %}" href="#booking">Rezervă</a>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <div class="addons reveal">
      <div><span>Pogăcele, sărățele</span><b>15 lei</b></div>
      <div><span>Platou rece (brânză, șuncă, cârnați din Valea Ierului)</span><b>45 lei</b></div>
      <div><span>Evenimente corporate, peste 20 pers.</span><b>ofertă personalizată</b></div>
      <div><span>Transfer din Oradea (max. 8 pers.)</span><b>la cerere</b></div>
    </div>

    <p class="pk-note">{{ section.settings.pk_note }}</p>

    <div class="booking reveal" id="booking">
      <div>
        <div class="eyebrow">Rezervare</div>
        <h3 style="margin-top:.6rem">{{ section.settings.taste_cta }}</h3>
        <p style="color:var(--fog);font-size:.9rem">{{ section.settings.contact_hours }}</p>
        <p>
          <a href="tel:+40742908047" style="color:var(--amber-2);text-decoration:none">+40 742 908 047</a><br>
          <a href="mailto:office@epalinca.ro" style="color:var(--amber-2);text-decoration:none">office@epalinca.ro</a>
        </p>
      </div>

      {%- comment -%}
        In the reference this form was a demo that never submitted. Here it is a real
        Shopify contact form. Each field keeps the prototype's `id` so the live price
        estimator in zekulhyda.js still finds it, while `name="contact[...]"` is what
        actually gets emailed to the shop.
      {%- endcomment -%}
      {% form 'contact', id: 'bkForm' %}
        {%- if form.posted_successfully? %}
          <p class="demo" style="color:var(--amber-2)">Mulțumim! Am primit cererea, revenim cu confirmarea.</p>
        {%- endif %}
        {%- if form.errors %}
          <p class="demo" style="color:#e8a1a1">{{ form.errors.translated_fields.email | default: 'Verificați câmpurile' }} — {{ form.errors.messages.email }}</p>
        {%- endif %}

        <label><span>Data</span><input type="date" required id="date" name="contact[Data]"></label>
        <label><span>Nr. persoane</span><input type="number" min="6" max="40" value="8" required id="ppl" name="contact[Persoane]"></label>
        <label><span>Pachet</span>
          <select id="bkPack" name="contact[Pachet]">
            {%- for block in section.blocks -%}
              {%- if block.type == 'pack' -%}
                <option{% if block.settings.highlight %} selected{% endif %}>{{ block.settings.name }}</option>
              {%- endif -%}
            {%- endfor -%}
          </select>
        </label>
        <label><span>Mâncare</span>
          <select id="food" name="contact[Mancare]">
            <option>Doar pogăcele</option>
            <option>Platou rece</option>
          </select>
        </label>
        <label><span>Nume</span><input required name="contact[Nume]"></label>
        <label><span>Telefon / e-mail</span><input required type="email" name="contact[email]"></label>

        <div class="estimate" id="estimate"></div>
        <button class="btn primary full" type="submit">Trimite cererea</button>
        <span class="demo">Prețul afișat este orientativ; confirmarea finală vine pe e-mail.</span>
      {% endform %}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Degustare",
  "settings": [
    { "type": "text", "id": "taste_eyebrow", "label": "Etichetă", "default": "Zekulhyda Taste & Learning" },
    { "type": "textarea", "id": "taste_title", "label": "Titlu", "default": "Vino la Săcueni, <em>degustă cu maestrul distilator.</em>" },
    { "type": "textarea", "id": "taste_p", "label": "Descriere", "default": "Sala în care se jurizează și probele Blisseva Partium Spirits Award. Degustare ghidată cu 5 pălinci și prezentarea distileriei." },
    { "type": "text", "id": "taste_1", "label": "Punct 1", "default": "Degustare ghidată · 5 sortimente" },
    { "type": "text", "id": "taste_2", "label": "Punct 2", "default": "Masterclass cu jurat internațional" },
    { "type": "text", "id": "taste_3", "label": "Punct 3", "default": "Grupuri corporate și de prieteni, 6–20 persoane" },
    { "type": "text", "id": "pk_eyebrow", "label": "Pachete · etichetă", "default": "Pachete de degustare" },
    { "type": "textarea", "id": "pk_title", "label": "Pachete · titlu", "default": "Alege pachetul — <em>prețul este pe persoană.</em>" },
    { "type": "textarea", "id": "pk_sub", "label": "Pachete · subtitlu", "default": "Toate degustările se țin cu programare, pentru grupuri de 6–20 persoane." },
    { "type": "textarea", "id": "pk_note", "label": "Notă", "default": "Vizita distileriei se face cu programare prealabilă. Servim alcool doar persoanelor peste 18 ani." },
    { "type": "text", "id": "taste_cta", "label": "Titlu rezervare", "default": "Cer o programare" },
    { "type": "text", "id": "contact_hours", "label": "Program", "default": "Degustări cu programare prealabilă" }
  ],
  "blocks": [
    {
      "type": "pack",
      "name": "Pachet",
      "settings": [
        { "type": "text", "id": "name", "label": "Nume pachet" },
        { "type": "text", "id": "tag", "label": "Etichetă colț" },
        { "type": "checkbox", "id": "highlight", "label": "Evidențiat", "default": false },
        { "type": "text", "id": "time", "label": "Durată" },
        { "type": "text", "id": "people", "label": "Nr. persoane" },
        { "type": "number", "id": "price_weekday", "label": "Preț zi lucrătoare (lei)" },
        { "type": "number", "id": "price_weekend", "label": "Preț weekend (lei)" },
        { "type": "text", "id": "item_1", "label": "Include 1" },
        { "type": "text", "id": "item_2", "label": "Include 2" },
        { "type": "text", "id": "item_3", "label": "Include 3" },
        { "type": "text", "id": "item_4", "label": "Include 4" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Degustare & pachete",
      "blocks": [
        { "type": "pack", "settings": { "name": "Degustarea Valea Ierului", "time": "cca. 1,5 ore", "people": "6–20 pers.", "price_weekday": 90, "price_weekend": 110, "item_1": "5 pălinci medaliate, degustare ghidată", "item_2": "Prezentarea distileriei și a distilării", "item_3": "Pahar de degustare, apă, pogăcele" } },
        { "type": "pack", "settings": { "name": "Degustarea campionilor", "tag": "TOP", "highlight": true, "time": "cca. 2,5 ore", "people": "6–20 pers.", "price_weekday": 140, "price_weekend": 160, "item_1": "8 pălinci: cei doi campioni de categorie și seria Barrique", "item_2": "Vizita distileriei, de la fruct la sticlă", "item_3": "Platou rece cu produse din Valea Ierului", "item_4": "10% reducere la cumpărăturile de la fața locului" } },
        { "type": "pack", "settings": { "name": "Masterclass cu Botond", "time": "cca. 3 ore", "people": "8–16 pers.", "price_weekday": 220, "price_weekend": 250, "item_1": "10 probe, cu fișă de evaluare ca la concurs", "item_2": "Degustare oarbă și recunoașterea defectelor", "item_3": "Platou rece și o sticlă de 0,35 l cadou", "item_4": "Diplomă de participare" } }
      ]
    }
  ]
}
{% endschema %}
