<footer>
  <div class="wrap">
    {% render 'zk-logo' %}

    <div>
      © {{ 'now' | date: '%Y' }} {{ section.settings.company | default: 'Zekulhyda S.R.L.' }}
      {%- if section.settings.company_ids != blank %} · {{ section.settings.company_ids }}{% endif %}
      · <span>{% render 'zk-t', override: section.settings.foot_legal, key: 'zk.foot_legal' %}</span>
    </div>

    {%- comment -%}
      The legal links a Romanian webshop has to carry: the five policy pages, plus the
      two dispute-resolution links consumer law requires a trader to link to — ANPC's SAL
      page and the European Commission's ODR/SOL platform. Extra links can be added as
      blocks in the theme editor; they replace this list entirely.
    {%- endcomment -%}
    <div class="foot-legal">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          <a href="{{ block.settings.link | default: '#' }}" {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
        {%- endfor -%}
      {%- else -%}
        <a href="{{ pages['termeni-si-conditii'].url }}">{{ 'zk.foot_link_terms' | t }}</a>
        <a href="{{ pages['politica-de-confidentialitate'].url }}">{{ 'zk.foot_link_privacy' | t }}</a>
        <a href="{{ pages['politica-cookies'].url }}">{{ 'zk.foot_link_cookies' | t }}</a>
        <a href="{{ pages['politica-de-retur'].url }}">{{ 'zk.foot_link_returns' | t }}</a>
        <a href="{{ pages['livrare-si-plata'].url }}">{{ 'zk.foot_link_shipping' | t }}</a>
        <a href="{{ pages['contact'].url }}">{{ 'zk.nav_contact' | t }}</a>
        <a href="https://anpc.ro/ce-este-sal/" target="_blank" rel="noopener">ANPC · SAL</a>
        <a href="https://ec.europa.eu/consumers/odr" target="_blank" rel="noopener">SOL · ODR</a>
      {%- endif -%}
    </div>

    {% render 'zk-social' %}
  </div>
</footer>

{% schema %}
{
  "name": "Subsol",
  "settings": [
    {
      "type": "text",
      "id": "company",
      "label": "Firmă",
      "default": "Grădina Verde S.R.L."
    },
    {
      "type": "text",
      "id": "company_ids",
      "label": "CUI / Reg. Com.",
      "default": "CUI RO15476755 · J05/672/2003"
    },
    {
      "type": "textarea",
      "id": "foot_legal",
      "label": "Avertisment",
      "info": "Gol = textul tradus din locales/"
    }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Link subsol",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Text",
          "default": "Link"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Adresă"
        }
      ]
    }
  ]
}
{% endschema %}
