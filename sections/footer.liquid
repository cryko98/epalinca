<footer>
  <div class="wrap">
    {% render 'zk-logo' %}

    <div>
      © {{ 'now' | date: '%Y' }} {{ section.settings.company | default: 'Zekulhyda S.R.L.' }}
      {%- if section.settings.company_ids != blank %} · {{ section.settings.company_ids }}{% endif %}
      · <span>{% render 'zk-t', override: section.settings.foot_legal, key: 'zk.foot_legal' %}</span>
    </div>

    <div>
      {%- for block in section.blocks -%}
        <a href="{{ block.settings.link | default: '#' }}" {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
      {%- else -%}
        <a href="{{ routes.root_url }}pages/termeni-si-conditii">{{ 'zk.foot_link_terms' | t }}</a>
        <a href="{{ routes.root_url }}pages/politica-de-confidentialitate">{{ 'zk.foot_link_privacy' | t }}</a>
        <a href="https://anpc.ro" target="_blank" rel="noopener">ANPC</a>
      {%- endfor -%}
    </div>

    {% render 'zk-social' %}
  </div>
</footer>

{% schema %}
{
  "name": "Subsol",
  "settings": [
    {
      "type": "text",
      "id": "company",
      "label": "Firmă",
      "default": "Zekulhyda S.R.L."
    },
    {
      "type": "text",
      "id": "company_ids",
      "label": "CUI / Reg. Com.",
      "default": "CUI 40648975 · J05/686/2019"
    },
    {
      "type": "textarea",
      "id": "foot_legal",
      "label": "Avertisment",
      "info": "Gol = textul tradus din locales/"
    }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Link subsol",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Text",
          "default": "Link"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Adresă"
        }
      ]
    }
  ]
}
{% endschema %}
