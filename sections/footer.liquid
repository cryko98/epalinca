<footer>
  <div class="wrap">
    {% render 'zk-logo' %}

    <div>
      © {{ 'now' | date: '%Y' }} {{ section.settings.company | default: 'Zekulhyda S.R.L.' }}
      {%- if section.settings.company_ids != blank %} · {{ section.settings.company_ids }}{% endif %}
      · <span>{{ section.settings.foot_legal | default: 'Consumul excesiv de alcool dăunează sănătății. Interzis minorilor.' }}</span>
    </div>

    <div>
      {%- for block in section.blocks -%}
        <a href="{{ block.settings.link | default: '#' }}" {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
      {%- else -%}
        <a href="{{ routes.root_url }}pages/termeni-si-conditii">Termeni și condiții</a>
        <a href="{{ routes.root_url }}pages/politica-de-confidentialitate">Confidențialitate</a>
        <a href="https://anpc.ro" target="_blank" rel="noopener">ANPC</a>
      {%- endfor -%}
    </div>

    {% render 'zk-social' %}
  </div>
</footer>

{% schema %}
{
  "name": "Subsol",
  "settings": [
    { "type": "text", "id": "company", "label": "Firmă", "default": "Zekulhyda S.R.L." },
    { "type": "text", "id": "company_ids", "label": "CUI / Reg. Com.", "default": "CUI 40648975 · J05/686/2019" },
    { "type": "textarea", "id": "foot_legal", "label": "Avertisment", "default": "Consumul excesiv de alcool dăunează sănătății. Interzis minorilor." }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Link subsol",
      "settings": [
        { "type": "text", "id": "label", "label": "Text", "default": "Link" },
        { "type": "url", "id": "link", "label": "Adresă" }
      ]
    }
  ]
}
{% endschema %}
