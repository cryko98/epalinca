      "label": "Link Facebook"
    },
    {
      "type": "url",
      "id": "instagram",
      "label": "Link Instagram"
    },
    {
      "type": "header",
      "content": "Date Firma (Obligatorii)"
    },
    {
      "type": "text",
      "id": "contact_heading",
      "label": "Titlu coloana contact",
      "default": "Contact si Date Legale"
    },
    {
      "type": "text",
      "id": "company_name",
      "label": "Denumire firma",
      "default": "Zekulhyda Premium SRL"
    },
    {
      "type": "text",
      "id": "address",
      "label": "Adresa strada",
      "default": "Str. Principala nr. 1"
    },
    {
      "type": "text",
      "id": "city",
      "label": "Localitate, Judet",
      "default": "Sacueni, Judetul Bihor, Romania"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Telefon",
      "default": "+40 XXX XXX XXX"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email",
      "default": "contact@zekulhyda.ro"
    },
    {
      "type": "text",
      "id": "cui",
      "label": "CUI",
      "default": "RO XXXXXXXX"
    },
    {
      "type": "text",
      "id": "reg_com",
      "label": "Nr. Registrul Comertului",
      "default": "J05/XXX/XXXX"
    },
    {
      "type": "header",
      "content": "Avertisment Alcool"
    },
    {
      "type": "textarea",
      "id": "alcohol_warning",
      "label": "Text avertisment",
      "default": "AVERTISMENT: Consumul de alcool in exces dauneaza grav sanatatii. Interzis vanzarea si servirea bauturilor alcoolice minorilor sub 18 ani. Nu conduceti sub influenta alcoolului. Consumati responsabil."
    },
    {
      "type": "header",
      "content": "Linkuri Legale"
    },
    {
      "type": "text",
      "id": "copyright",
      "label": "Text copyright",
      "default": "2025 Zekulhyda Premium. Toate drepturile rezervate."
    },
    {
      "type": "text",
      "id": "privacy_label",
      "label": "Text Politica Confidentialitate",
      "default": "Politica de Confidentialitate"
    },
    {
      "type": "url",
      "id": "privacy_url",
      "label": "Link Politica Confidentialitate"
    },
    {
      "type": "text",
      "id": "terms_label",
      "label": "Text Termeni si Conditii",
      "default": "Termeni si Conditii"
    },
    {
      "type": "url",
      "id": "terms_url",
      "label": "Link Termeni si Conditii"
    },
    {
      "type": "text",
      "id": "cookies_label",
      "label": "Text Politica Cookies",
      "default": "Politica de Cookies"
    },
    {
      "type": "url",
      "id": "cookies_url",
      "label": "Link Politica Cookies"
    }
  ],
  "blocks": [
    {
      "type": "link_col",
      "name": "Coloana Linkuri",
      "limit": 3,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Titlu coloana",
          "default": "Produse"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Meniu linkuri"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Subsol",
      "blocks": [
        { "type": "link_col", "settings": { "heading": "Produse" } },
        { "type": "link_col", "settings": { "heading": "Distileria" } }
