<section id="distilat"><div class="wrap">
  <div class="mosaic"><figure><img src="{{ 'zk-11.jpg' | asset_url }}" alt="Grapefruit distillate"></figure><figure><img src="{{ 'zk-12.jpg' | asset_url }}" alt="Ginger distillate"></figure><figure><img src="{{ 'zk-13.jpg' | asset_url }}" alt="Lime distillate in a crate of limes"></figure><figure><img src="{{ 'zk-14.jpg' | asset_url }}" alt="Lemon distillate among lemons"></figure><figure><img src="{{ 'zk-15.jpg' | asset_url }}" alt="Orange distillate"></figure><figure><img src="{{ 'zk-16.jpg' | asset_url }}" alt="Banana distillate"></figure></div>
  <div class="text reveal"><div class="eyebrow">{% render 'zk-t', override: section.settings.ds_eyebrow, key: 'zk.ds_eyebrow' %}</div><h2 style="margin:.6rem 0 1.2rem">{% render 'zk-t', override: section.settings.ds_title, key: 'zk.ds_title' %}</h2><p>{% render 'zk-t', override: section.settings.ds_p, key: 'zk.ds_p' %}</p>
    <div class="flavors" id="flavors"></div>
    <ul class="serves"><b>{% render 'zk-t', override: section.settings.ds_serve, key: 'zk.ds_serve' %}</b><li>{% render 'zk-t', override: section.settings.ds_serve_1, key: 'zk.ds_serve_1' %}</li><li>{% render 'zk-t', override: section.settings.ds_serve_2, key: 'zk.ds_serve_2' %}</li><li>{% render 'zk-t', override: section.settings.ds_serve_3, key: 'zk.ds_serve_3' %}</li></ul>
    <a class="btn" href="#shop" data-f="distilat">{% render 'zk-t', override: section.settings.ds_cta, key: 'zk.ds_cta' %}</a></div>
</div></section>

{% schema %}
{
  "name": "Distilat",
  "settings": [
    {
      "type": "text",
      "id": "ds_eyebrow",
      "label": "Ds eyebrow",
      "info": "Gol = textul tradus din locales/"
    },
    {
      "type": "text",
      "id": "ds_title",
      "label": "Ds title",
      "info": "Gol = textul tradus din locales/"
    },
    {
      "type": "textarea",
      "id": "ds_p",
      "label": "Ds p",
      "info": "Gol = textul tradus din locales/"
    },
    {
      "type": "text",
      "id": "ds_serve",
      "label": "Ds serve",
      "info": "Gol = textul tradus din locales/"
    },
    {
      "type": "text",
      "id": "ds_serve_1",
      "label": "Ds serve 1",
      "info": "Gol = textul tradus din locales/"
    },
    {
      "type": "text",
      "id": "ds_serve_2",
      "label": "Ds serve 2",
      "info": "Gol = textul tradus din locales/"
    },
    {
      "type": "text",
      "id": "ds_serve_3",
      "label": "Ds serve 3",
      "info": "Gol = textul tradus din locales/"
    },
    {
      "type": "text",
      "id": "ds_cta",
      "label": "Ds cta",
      "info": "Gol = textul tradus din locales/"
    }
  ],
  "presets": [
    {
      "name": "Distilat — sticla albastră"
    }
  ]
}
{% endschema %}
