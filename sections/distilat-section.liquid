<section id="distilat"><div class="wrap">
  <div class="mosaic"><figure><img src="{{ 'zk-11.jpg' | asset_url }}" alt="Grapefruit distillate"></figure><figure><img src="{{ 'zk-12.jpg' | asset_url }}" alt="Ginger distillate"></figure><figure><img src="{{ 'zk-13.jpg' | asset_url }}" alt="Lime distillate in a crate of limes"></figure><figure><img src="{{ 'zk-14.jpg' | asset_url }}" alt="Lemon distillate among lemons"></figure><figure><img src="{{ 'zk-15.jpg' | asset_url }}" alt="Orange distillate"></figure><figure><img src="{{ 'zk-16.jpg' | asset_url }}" alt="Banana distillate"></figure></div>
  <div class="text reveal"><div class="eyebrow">{{ section.settings.ds_eyebrow }}</div><h2 style="margin:.6rem 0 1.2rem">{{ section.settings.ds_title }}</h2><p>{{ section.settings.ds_p }}</p>
    <div class="flavors" id="flavors"></div>
    <ul class="serves"><b>{{ section.settings.ds_serve }}</b><li>{{ section.settings.ds_serve_1 }}</li><li>{{ section.settings.ds_serve_2 }}</li><li>{{ section.settings.ds_serve_3 }}</li></ul>
    <a class="btn" href="#shop" data-f="distilat">{{ section.settings.ds_cta }}</a></div>
</div></section>

{% schema %}
{
  "name": "Distilat",
  "settings": [
    {
      "type": "text",
      "id": "ds_eyebrow",
      "label": "Ds eyebrow",
      "default": "Distilat · Sticla albastră"
    },
    {
      "type": "text",
      "id": "ds_title",
      "label": "Ds title",
      "default": "Aceeași mână, <em>alt fruct.</em>"
    },
    {
      "type": "textarea",
      "id": "ds_p",
      "label": "Ds p",
      "default": "Șapte distilate curate din citrice, banane și ghimbir — 42%, 0,5 l, în sticla albastră striată. Nu lichior, nu aromă: fruct adevărat, distilat. Simplu, cu gheață sau cu tonic — pentru oaspeții mai tineri și pentru baruri."
    },
    {
      "type": "text",
      "id": "ds_serve",
      "label": "Ds serve",
      "default": "Recomandarea casei"
    },
    {
      "type": "text",
      "id": "ds_serve_1",
      "label": "Ds serve 1",
      "default": "Distilat de lime + tonic + felie de lime"
    },
    {
      "type": "text",
      "id": "ds_serve_2",
      "label": "Ds serve 2",
      "default": "Distilat de ghimbir + ginger ale, cu gheață"
    },
    {
      "type": "text",
      "id": "ds_serve_3",
      "label": "Ds serve 3",
      "default": "Distilat de portocale simplu, răcit la −18 °C"
    },
    {
      "type": "text",
      "id": "ds_cta",
      "label": "Ds cta",
      "default": "Seria Distilat"
    }
  ],
  "presets": [
    {
      "name": "Distilat — sticla albastră"
    }
  ]
}
{% endschema %}
