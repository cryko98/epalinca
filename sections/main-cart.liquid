<div class="cart-page" style="padding-top:80px;">
  <div class="section-inner cart-page__inner">

    <div class="section-label" style="margin-bottom:20px;">
      <span class="section-label-line"></span>
      <span class="section-label-text">Comanda ta</span>
    </div>
    <h1 class="cart-page__title">{{ 'cart.title' | t }}</h1>

    {% if cart.item_count > 0 %}
      <form action="/cart" method="post" id="CartForm">
        <div class="cart-page__grid">

          <div class="cart-page__items">
            {% for item in cart.items %}
              <div class="cart-item">
                <div class="cart-item__img">
                  {% if item.image %}
                    <img src="{{ item.image | image_url: width:200 }}" alt="{{ item.title }}" loading="lazy">
                  {% else %}
                    {% render 'bottle-svg', color: 'premium' %}
                  {% endif %}
                </div>
                <div class="cart-item__info">
                  <a href="{{ item.url }}" class="cart-item__name">{{ item.product_title }}</a>
                  {% unless item.variant.title == 'Default Title' %}
                    <p class="cart-item__variant">{{ item.variant.title }}</p>
                  {% endunless %}
                  <p class="cart-item__vendor">{{ item.vendor }}</p>
                </div>
                <div class="cart-item__qty">
                  <button type="button" onclick="var i=document.getElementById('qty_{{ item.id }}'); if(i.value>1){i.value=parseInt(i.value)-1;}">−</button>
                  <input type="number" name="updates[{{ item.id }}]"
                         id="qty_{{ item.id }}"
                         value="{{ item.quantity }}" min="0" max="99">
                  <button type="button" onclick="var i=document.getElementById('qty_{{ item.id }}'); i.value=parseInt(i.value)+1;">+</button>
                </div>
                <div class="cart-item__price">{{ item.final_line_price | money }}</div>
                <a href="/cart/change?id={{ item.id }}&quantity=0" class="cart-item__remove" aria-label="Elimină">✕</a>
              </div>
            {% endfor %}
          </div>

          <div class="cart-page__summary">
            <div class="cart-summary__block">
              <div class="cart-summary__row">
                <span>Subtotal</span>
                <span>{{ cart.total_price | money }}</span>
              </div>
              <p class="cart-summary__shipping">
                Transportul și taxele se calculează la finalizarea comenzii.
              </p>
              <p class="cart-summary__warning">
                ⚠️ Vânzarea de băuturi alcoolice este interzisă minorilor sub 18 ani.
              </p>
              <button type="submit" name="checkout" class="btn-primary cart-summary__checkout">
                Finalizează Comanda →
              </button>
              <a href="/collections/all" class="btn-ghost" style="margin-top:16px;display:inline-flex;">
                ← Continuă cumpărăturile
              </a>
            </div>
          </div>

        </div>

        <button type="submit" name="update" class="cart-page__update">
          Actualizează coșul
        </button>
      </form>

    {% else %}
      <div class="cart-page__empty">
        <p>{{ 'cart.empty' | t }}</p>
        <a href="/collections/all" class="btn-primary" style="margin-top:32px;display:inline-flex;">
          Descoperă Colecția →
        </a>
      </div>
    {% endif %}

  </div>
</div>

<style>
.cart-page__inner { padding-top:48px; padding-bottom:120px; }
.cart-page__title { font-family:var(--font-display); font-size:48px; font-weight:400; color:var(--color-cream); margin-bottom:56px; }
.cart-page__grid { display:grid; grid-template-columns:1.5fr 1fr; gap:60px; align-items:start; }
.cart-item { display:grid; grid-template-columns:80px 1fr auto auto auto; gap:20px; align-items:center; padding:24px 0; border-bottom:1px solid rgba(240,234,216,.06); }
.cart-item__img { width:80px; height:80px; background:var(--color-surface2); display:flex; align-items:center; justify-content:center; overflow:hidden; }
.cart-item__img img { width:100%; height:100%; object-fit:contain; }
.cart-item__img .bottle-svg { width:40px; }
.cart-item__name { font-family:var(--font-display); font-size:18px; color:var(--color-cream); display:block; margin-bottom:6px; transition:color .3s; }
.cart-item__name:hover { color:var(--color-gold-hi); }
.cart-item__variant, .cart-item__vendor { font-size:10px; letter-spacing:2px; text-transform:uppercase; color:var(--color-cream-dim); }
.cart-item__qty { display:flex; align-items:center; }
.cart-item__qty button { width:32px; height:32px; background:var(--color-surface2); border:1px solid rgba(240,234,216,.1); color:var(--color-cream); cursor:pointer; font-size:14px; transition:background .3s; }
.cart-item__qty button:hover { background:var(--color-surface); }
.cart-item__qty input { width:48px; height:32px; text-align:center; background:var(--color-surface); border:1px solid rgba(240,234,216,.1); border-left:none; border-right:none; color:var(--color-cream); font-family:var(--font-display); font-size:16px; outline:none; }
.cart-item__price { font-family:var(--font-display); font-size:20px; color:var(--color-cream); min-width:80px; text-align:right; }
.cart-item__remove { color:rgba(240,234,216,.3); font-size:14px; transition:color .3s; }
.cart-item__remove:hover { color:var(--color-cream); }
.cart-summary__block { background:var(--color-surface); padding:36px; position:sticky; top:100px; }
.cart-summary__row { display:flex; justify-content:space-between; align-items:center; margin-bottom:20px; }
.cart-summary__row span:first-child { font-size:10px; letter-spacing:3px; text-transform:uppercase; color:var(--color-cream-dim); }
.cart-summary__row span:last-child { font-family:var(--font-display); font-size:28px; color:var(--color-cream); }
.cart-summary__shipping { font-size:11px; color:rgba(240,234,216,.3); margin-bottom:16px; line-height:1.5; }
.cart-summary__warning { font-size:10px; color:rgba(184,150,62,.4); margin-bottom:28px; line-height:1.5; border-top:1px solid rgba(184,150,62,.1); padding-top:16px; }
.cart-summary__checkout { width:100%; justify-content:center; padding:18px; font-size:11px; letter-spacing:4px; }
.cart-page__update { display:none; }
.cart-page__empty { text-align:center; padding:80px 0; font-family:var(--font-serif); font-size:18px; font-style:italic; color:var(--color-cream-dim); }
@media(max-width:900px){ .cart-page__grid{grid-template-columns:1fr;} .cart-item{grid-template-columns:60px 1fr auto; grid-template-rows:auto auto;} .cart-item__price{grid-column:3;} .cart-item__remove{grid-column:3;} }
</style>

{% schema %}
{"name": "Main Cos", "settings": []}
{% endschema %}
