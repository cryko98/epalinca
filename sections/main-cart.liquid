{%- liquid
  if cart.item_count == 1
    assign word = 'zk.product_one' | t
  else
    assign word = 'zk.product_many' | t
  endif
  assign meta = cart.item_count | append: ' ' | append: word

  comment
    render arguments cannot take filters, so the translated strings are resolved here.
  endcomment
  assign head_eyebrow = 'zk.cart_eyebrow' | t
  assign head_title = 'cart.title' | t
-%}

{% render 'zk-page-head', eyebrow: head_eyebrow, title: head_title, meta: meta %}

<section class="zk-cart">
  <div class="wrap zk-body">

    {%- if cart.item_count > 0 -%}
      <form action="{{ routes.cart_url }}" method="post" novalidate id="CartForm">
        <div class="zk-cart__grid">

          <div class="zk-cart__items">
            {%- for item in cart.items -%}
              <div class="zk-cart__row">
                <a class="zk-cart__pic" href="{{ item.url }}">
                  {%- if item.image -%}
                    <img src="{{ item.image | image_url: width: 240 }}" alt="{{ item.title | escape }}" loading="lazy" width="120" height="150">
                  {%- else -%}
                    {% render 'bottle-svg', color: 'premium' %}
                  {%- endif -%}
                </a>

                <div class="zk-cart__info">
                  <a class="zk-cart__name" href="{{ item.url }}">{{ item.product.title | default: item.title }}</a>
                  <div class="zk-cart__meta">
                    {%- unless item.variant.title == 'Default Title' -%}
                      <span>{{ item.variant.title }}</span>
                    {%- endunless -%}
                    {%- if item.product.type != blank -%}<span>{{ item.product.type }}</span>{%- endif -%}
                  </div>
                  <div class="zk-cart__unit">{{ item.final_price | money }} / {{ 'zk.piece' | t }}</div>
                </div>

                <div class="zk-cart__qty">
                  <button type="button" data-step="-1" data-for="qty_{{ item.key }}" aria-label="−">−</button>
                  <input type="number" id="qty_{{ item.key }}" name="updates[{{ item.key }}]"
                         value="{{ item.quantity }}" min="0" max="99"
                         aria-label="{{ 'products.quantity' | t }}">
                  <button type="button" data-step="1" data-for="qty_{{ item.key }}" aria-label="+">+</button>
                </div>

                <div class="zk-cart__line">{{ item.final_line_price | money }}</div>

                <a class="zk-cart__rm" href="{{ routes.cart_change_url }}?id={{ item.key }}&quantity=0"
                   aria-label="{{ 'cart.remove' | t }}" title="{{ 'cart.remove' | t }}">✕</a>
              </div>
            {%- endfor -%}

            <button type="submit" name="update" class="btn zk-cart__update">{{ 'cart.update' | t }}</button>
          </div>

          <aside class="zk-cart__summary">
            <div class="zk-cart__box">
              <div class="zk-cart__total">
                <span>{{ 'cart.subtotal' | t }}</span>
                <b>{{ cart.total_price | money }}</b>
              </div>

              <p class="zk-cart__note">{{ 'zk.cart_shipping_note' | t }}</p>

              <p class="zk-cart__warn">{{ 'zk.cart_age_note' | t }}</p>

              <button type="submit" name="checkout" class="btn primary zk-cart__checkout">
                {{ 'cart.checkout' | t }} →
              </button>

              <a class="zk-cart__back" href="{{ routes.all_products_collection_url }}">
                ← {{ 'cart.continue_shopping' | t }}
              </a>
            </div>
          </aside>

        </div>
      </form>

    {%- else -%}
      <div class="zk-cart__empty">
        <p>{{ 'cart.empty' | t }}</p>
        <a class="btn primary" href="{{ routes.all_products_collection_url }}">
          {{ 'zk.cart_discover' | t }} →
        </a>
      </div>
    {%- endif -%}

  </div>
</section>

<script>
  (function () {
    var form = document.getElementById('CartForm');
    if (!form) return;
    form.querySelectorAll('[data-step]').forEach(function (b) {
      b.addEventListener('click', function () {
        var input = document.getElementById(b.getAttribute('data-for'));
        if (!input) return;
        var n = parseInt(input.value || '1', 10) + parseInt(b.getAttribute('data-step'), 10);
        input.value = Math.max(0, Math.min(99, n));
        // A quantity change has to reach Shopify, so submit the update rather than
        // leaving the shopper looking at a number that has not been saved.
        form.querySelector('[name="update"]').click();
      });
    });
  })();
</script>

{% schema %}
{"name": "Main Cos", "settings": []}
{% endschema %}
