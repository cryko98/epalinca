{% layout none %}
<!DOCTYPE html>
<html lang="{{ request.locale.iso_code | default: 'ro' }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Card cadou — {{ shop.name }}</title>
  {{ content_for_header }}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;1,400&family=IBM+Plex+Mono:wght@400;500&family=Manrope:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    :root {
      --ink:#0B0B0C; --graphite:#151517; --line:#2C2C30; --fog:#8E9197;
      --gold:{{ settings.color_gold | default: '#C9963B' }}; --gold-hi:{{ settings.color_gold_hi | default: '#E4B65A' }};
      --cream:#F3F1EC; --cream-dim:#C9CBCF;
      --display:'Cormorant Garamond',Georgia,serif; --body:'Manrope','Helvetica Neue',Arial,sans-serif; --mono:'IBM Plex Mono',ui-monospace,monospace;
    }
    * { box-sizing:border-box; }
    body { margin:0; background:var(--ink); color:var(--cream); font-family:var(--body); display:flex; align-items:center; justify-content:center; min-height:100vh; padding:40px 20px; }
    .gc { max-width:520px; width:100%; text-align:center; }
    .gc__brand { font-family:var(--mono); font-size:12px; letter-spacing:.42em; color:var(--gold); text-transform:uppercase; }
    .gc__title { font-family:var(--display); font-size:clamp(30px,5vw,44px); font-weight:400; margin:20px 0 6px; }
    .gc__sub { font-family:var(--display); font-style:italic; font-size:17px; color:var(--cream-dim); margin-bottom:36px; }
    .gc__card { border:1px solid var(--line); background:var(--graphite); padding:36px 28px; border-radius:3px; }
    .gc__value { font-family:var(--display); font-size:clamp(44px,8vw,64px); color:var(--gold); line-height:1; }
    .gc__initial { font-family:var(--mono); font-size:11px; letter-spacing:.1em; color:var(--fog); text-transform:uppercase; margin-top:10px; }
    .gc__qr { margin:28px auto 22px; background:#fff; padding:12px; width:fit-content; border-radius:2px; }
    .gc__code { font-family:var(--mono); font-size:19px; letter-spacing:.16em; color:var(--cream); border:1px dashed var(--line); padding:14px; margin-top:8px; word-break:break-all; }
    .gc__expiry { font-family:var(--mono); font-size:11px; color:var(--fog); margin-top:16px; letter-spacing:.06em; }
    .gc__disabled { color:#e8a1a1; font-family:var(--mono); font-size:12px; letter-spacing:.08em; margin-top:16px; text-transform:uppercase; }
    .gc__actions { margin-top:28px; display:flex; gap:12px; justify-content:center; flex-wrap:wrap; }
    .gc__btn { display:inline-block; background:var(--gold); color:var(--ink); text-decoration:none; padding:13px 26px; font-family:var(--mono); font-size:12px; letter-spacing:.1em; text-transform:uppercase; border-radius:2px; }
    .gc__btn:hover { background:var(--gold-hi); }
    .gc__btn--ghost { background:transparent; color:var(--cream); border:1px solid var(--line); }
    .gc__warning { font-family:var(--mono); font-size:10px; letter-spacing:.06em; color:var(--fog); margin-top:40px; line-height:1.9; }
    @media print { .gc__actions { display:none; } body { background:#fff; color:#000; } }
  </style>
</head>
<body>
  <div class="gc">
    <p class="gc__brand">ZEKULHYDA</p>
    <h1 class="gc__title">Card cadou</h1>
    <p class="gc__sub">Un dar din pivniță</p>

    <div class="gc__card">
      <p class="gc__value">{{ gift_card.balance | money }}</p>
      {%- if gift_card.balance != gift_card.initial_value %}
        <p class="gc__initial">Valoare inițială: {{ gift_card.initial_value | money }}</p>
      {%- endif %}

      {%- if gift_card.qr_identifier %}
        <div class="gc__qr">
          <img src="/services/gift_card_images/{{ gift_card.qr_identifier }}.png"
               alt="Cod QR pentru cardul cadou" width="160" height="160">
        </div>
      {%- endif %}

      <p class="gc__code">{{ gift_card.code | format_code }}</p>

      {%- if gift_card.expires_on and gift_card.enabled %}
        <p class="gc__expiry">Valabil până la {{ gift_card.expires_on | date: '%d.%m.%Y' }}</p>
      {%- endif %}

      {%- unless gift_card.enabled %}
        <p class="gc__disabled">Acest card cadou este dezactivat</p>
      {%- endunless %}
    </div>

    <div class="gc__actions">
      <a href="{{ shop.url }}" class="gc__btn">Folosește cardul</a>
      <a href="#" onclick="window.print();return false;" class="gc__btn gc__btn--ghost">Printează</a>
    </div>

    <p class="gc__warning">
      {{ settings.alcohol_warning | default: 'Consumul de alcool în exces dăunează sănătății. Interzis minorilor.' }}
    </p>
  </div>
</body>
</html>
