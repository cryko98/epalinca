<!DOCTYPE html>
<html lang="{{ request.locale.iso_code | default: 'ro' }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ shop.name }}</title>
  <meta name="description" content="{{ page_description | escape }}">
  {{ content_for_header }}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Manrope:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
  {{ 'zekulhyda.css' | asset_url | stylesheet_tag }}
  <style>
    :root {
      --color-bg:        {{ settings.color_ink | default: '#0B0B0C' }};
      --color-ink:       {{ settings.color_ink | default: '#0B0B0C' }};
      --color-graphite:  #151517;
      --color-line:      #2C2C30;
      --color-fog:       #8E9197;
      --color-gold:      {{ settings.color_gold | default: '#C9963B' }};
      --color-gold-hi:   {{ settings.color_gold_hi | default: '#E4B65A' }};
      --color-gold-lo:   #7A5416;
      --color-cream:     #F3F1EC;
      --color-cream-dim: #C9CBCF;
      --font-display:    'Cormorant Garamond', Georgia, serif;
      --font-body:       'Manrope', 'Helvetica Neue', Arial, sans-serif;
      --font-mono:       'IBM Plex Mono', ui-monospace, monospace;
      --font-serif:      'Cormorant Garamond', Georgia, serif;
    }
    body { margin:0; background:var(--color-bg); color:var(--color-cream); font-family:var(--font-body); }
    .pw { min-height:100vh; display:flex; align-items:center; justify-content:center; padding:40px 24px; text-align:center; }
    .pw__box { max-width:460px; width:100%; }
    .pw__brand { font-family:var(--font-mono); font-size:13px; letter-spacing:.42em; color:var(--color-gold); text-transform:uppercase; }
    .pw__title { font-family:var(--font-display); font-size:clamp(34px,5vw,52px); font-weight:400; margin:24px 0 12px; }
    .pw__text { font-family:var(--font-serif); font-style:italic; font-size:17px; line-height:1.9; color:var(--color-cream-dim); margin-bottom:32px; }
    .pw__form { display:flex; border:1px solid var(--color-line); border-radius:2px; overflow:hidden; }
    .pw__form input[type="password"] { flex:1; background:var(--color-graphite); border:0; padding:14px 16px; color:var(--color-cream); font-family:var(--font-body); font-size:15px; }
    .pw__form input[type="password"]:focus { outline:none; }
    .pw__form button { background:var(--color-gold); border:0; color:var(--color-ink); padding:0 24px; font-family:var(--font-mono); font-size:12px; letter-spacing:.1em; text-transform:uppercase; cursor:pointer; }
    .pw__form button:hover { background:var(--color-gold-hi); }
    .pw__errors { color:#e8a1a1; font-size:14px; margin-bottom:16px; }
    .pw__warning { font-family:var(--font-mono); font-size:10px; letter-spacing:.08em; color:var(--color-fog); margin-top:48px; line-height:1.8; }
  </style>
</head>
<body>
  <div class="pw">
    <div class="pw__box">
      <p class="pw__brand">ZEKULHYDA</p>
      {{ content_for_layout }}
      <p class="pw__warning">
        {{ settings.alcohol_warning | default: 'Consumul de alcool în exces dăunează sănătății. Interzis minorilor.' }}
      </p>
    </div>
  </div>
</body>
</html>
