<!DOCTYPE html>
<html lang="{{ request.locale.iso_code | default: 'ro' }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% if page_title == blank %}{{ shop.name }}{% else %}{{ page_title }} — {{ shop.name }}{% endif %}</title>
  <meta name="description" content="{% if page_description %}{{ page_description | escape }}{% endif %}">
  {%- if settings.favicon != blank %}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 96 }}">
  {%- else %}
    <link rel="icon" type="image/png" href="{{ 'zk-01.png' | asset_url }}">
  {%- endif %}
  {{ content_for_header }}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Manrope:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap">
  {{ 'zekulhyda.css' | asset_url | stylesheet_tag }}
  {%- comment -%}
    The design's palette lives in assets/zekulhyda.css. Only the tokens a merchant can
    actually change are overridden here, so the stylesheet stays the single source of truth.
  {%- endcomment -%}
  <style>
    :root {
      --ink: {{ settings.color_ink | default: '#0B0B0C' }};
      --amber: {{ settings.color_gold | default: '#C9963B' }};
      --amber-2: {{ settings.color_gold_hi | default: '#E4B65A' }};
    }
  </style>
  {% render 'zk-image-map' %}
</head>
<body class="template-{{ template.name }}">

  {%- if settings.show_age_gate %}
    <div id="age" class="modal" hidden>
      <div class="box">
        <div class="eyebrow">Zekulhyda</div>
        {%- comment -%} The settings hold Romanian copy; the other storefront languages read the locale file. {%- endcomment -%}
        {%- if request.locale.iso_code == 'ro' -%}
          <h3>{{ settings.age_gate_title | default: 'Ai peste 18 ani?' }}</h3>
          <p>{{ settings.age_gate_text | default: 'Vindem băuturi alcoolice doar persoanelor majore. Prin continuare confirmi că ai împlinit 18 ani.' }}</p>
        {%- else -%}
          <h3>{{ 'zk.age_title' | t }}</h3>
          <p>{{ 'zk.age_p' | t }}</p>
        {%- endif -%}
        <div class="btns">
          <button class="btn primary" id="ageYes">{{ settings.age_gate_yes | default: 'Da, am peste 18 ani' }}</button>
          <a class="btn" href="https://www.google.com" id="ageNo">{{ settings.age_gate_no | default: 'Nu' }}</a>
        </div>
      </div>
    </div>
  {%- endif %}

  {% section 'header' %}

  <main id="MainContent" tabindex="-1">
    {{ content_for_layout }}
  </main>

  {% section 'footer' %}

  <script src="{{ 'zekulhyda.js' | asset_url }}" defer></script>
</body>
</html>
